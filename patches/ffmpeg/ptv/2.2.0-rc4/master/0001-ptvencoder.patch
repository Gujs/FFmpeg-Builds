+            } else {
+                a->fg_in_rate = a->dec->sample_rate;   /* the path is now configured for these */
+                a->fg_in_fmt  = a->dec->sample_fmt;
+                av_channel_layout_uninit(&a->fg_in_chl);
+                av_channel_layout_copy(&a->fg_in_chl, &a->dec->ch_layout);
+            }
