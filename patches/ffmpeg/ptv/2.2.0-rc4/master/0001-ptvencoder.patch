+                return audio_feed(a, frame);
+        }
+    } else if (a->afmt_stable) {                   /* params returned to normal → transient filtered out */
+        a->afmt_stable = 0;
+        afmt_q_reset(a);
+        av_channel_layout_uninit(&a->afmt_pending_chl);
+        a->afmt_pending_rate = 0; a->afmt_pending_fmt = AV_SAMPLE_FMT_NONE;
