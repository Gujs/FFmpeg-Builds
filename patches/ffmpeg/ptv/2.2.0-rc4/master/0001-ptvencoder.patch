+
+/* 2.2 T-423 (owner design rule 2026-10-24, GOALS 6: transport problems are fixed in FRONT of the encoder). A udp:// input
+ * given -regulate D is read here instead of by the demuxer: its TS packets go into one FIFO as they arrive and leave, to a
+ * loopback port the input then reads, at their PCR time + D — burst-and-gap delivery (HLS repackaged over SRT/UDP) reaches
+ * the encoder as a real-time stream. The open / reopen / reshape logic is unchanged: it reads the loopback URL.
+ * Measured with the prototype (test-results/v210-pre7/t423/pcrpace.py): Fintech's 6 s bursts every 6 s, house_skew +6.8 s
+ * and 411 repeats direct, 0 ms / 0 through D = 8 s.
+ * - the first PCR anchors arrival + D; every packet leaves at anchor + (its PCR - the anchor's), packets without a PCR with
+ *   the last PCR'd one;
+ * - a PCR jump (backwards by 0.1 s or more, or forwards > 1 s: a source restart, a wrap, a loop) continues the schedule
+ *   from the last scheduled time
+ *   (the prototype took a fresh D at a file loop and stalled the encoder 8.5 s; the later of the two moved a bursty source
+ *   later at every jump — Fintech's +2 s PCR jumps arrive early in their burst: 12 s held, 305 repeats); only after a
+ *   real outage (the arrivals stopped for 1 s or more, or a reopen) does it take arrival + D again, as a gateway
+ *   re-buffers to its latency — a jump while the data flowed keeps the schedule even when its time has passed (2.2
+ *   T-443: a wandering PCR's packet + D added its wander to the hold); a forward jump that comes with an
+ *   arrival stop of the same length is a hole (content lost in real time, T-437) and keeps the PCR schedule;
+ * - more than D + 10 s held (a source faster than real time for long): the oldest go, logged;
+ * - 2.2 T-439 (regulated by default, D 0.5 s): the schedule follows the source's delivery. Per 10 s, the packet that came
+ *   earliest against its PCR should wait exactly D; the schedule runs -(its wait - D) / 30 s faster or slower (at most
+ *   2 %) — a de-jitter buffer, not a de-wander one. Measured on 30 min of 8 production sources (test-results/t439): their
+ *   arrival against the PCR wanders up to 1 s over minutes (glo-3 origins; TOLLY after a PCR glitch delivered 3.7 s at
+ *   1.0067x real time); anchored once, the hold took all of it as delay (0.5 -> 4.9 s), and a source drifting the other
+ *   way would empty it for good. Packets later than D pass as they come (as unregulated), reported per minute;
+ * - the FIFO grows as it fills (a 0.5 s hold of a 5 Mb/s source is ~250 datagrams), up to the D + 10 s cap;
+ * - 2.2 T-441: a PCR that is no clock is not paced by — the input passes as it arrives (as unregulated), said once:
+ *   - it runs ahead of the arrivals: the earliest packet waits more than D + max(1 s, D / 2), longer in three 2 s windows
+ *     in a row (the servo at its limit and losing). One packager's sources (Lukentv: Heartland, Retro, Revn) stamp each 4 s
+ *     segment with 5.8 s of PCR and step back 1.8 s at the next, their PTS / DTS exact (fixture-media/cap-heartland-t441):
+ *     paced by that PCR the hold grew 1.8 s per segment (cor-3 pre10: 73 s in 3 min, the FIFO cap, 9905 of 14611 frames
+ *     repeated). A hole or a jitter burst raises the wait once, then it falls;
+ *   - it is too sparse: three times in 60 s the data flowed for more than 1 s with no PCR (Nothing But Sportz: one per
+ *     8.3 s segment; the spec says 0.1 s). A burst's PCR jump (Fintech's +2 s) comes with PCR packets close together;
+ * - 2.2 T-444: the switch is reversible. The schedule keeps running on the PCR while the input passes; 10 min without
+ *   either sign (no 1 s PCR gap while the data flowed, no 2 s window whose earliest packet would wait more than
+ *   D + max(1 s, D / 2)) and the input is regulated again: its current packet leaves now and the servo builds the hold
+ *   up to D (at most 2 %; ~1 min for D 0.5 s) — no step. Permanent, a glitch switched for good (cor-3 pre11: Western Bound
+ *   Port. on a PCR step, T-443; TruBLU on a third PCR gap inside 5 min of source damage, 7 such gaps in 3 h otherwise,
+ *   never three in 60 s) and over months every channel would end unregulated; Heartland's and Sportz's PCR never
+ *   look like a clock for 10 min, so they stay as they arrive. */
+
+#include <stdarg.h>
+#include <stdatomic.h>
+#include <string.h>
+#include <unistd.h>
+#include <pthread.h>
+#include <sys/socket.h>
+#include <netinet/in.h>
+#include <arpa/inet.h>
+
+#include "libavformat/avio.h"
+#include "libavutil/avstring.h"
+#include "libavutil/bprint.h"
+#include "libavutil/common.h"
+#include "libavutil/mathematics.h"
+#include "libavutil/log.h"
+#include "libavutil/mem.h"
+#include "libavutil/time.h"
+
+#include "ptvencoder.h"
+
+#define REG_DGRAM 1316                              /* 7 TS packets, the source's own datagram size */
+#define REG_SV_WIN   10000000                       /* T-439: the servo's window (us) */
+#define REG_SV_TAU   30                             /* T-439: its time constant (s) */
+#define REG_SV_MAX   20000                          /* T-439: its largest rate change (ppm) */
+#define REG_CAP0     2048                           /* T-439: the FIFO's first size (datagrams) */
+#define REG_RETRUST  600000000                      /* T-444: a clock again for this long (us) = regulated again */
+
+typedef struct RegItem {
+    int64_t due;
+    int     len;
+    uint8_t data[REG_DGRAM];
+} RegItem;
+
+typedef struct Regulator {
+    int             k;
+    char           *src_url;
+    int             port;
+    int64_t         delay;
+    pthread_t       rd, wr;
+    int             rd_ok, wr_ok;
+    pthread_mutex_t lock;
+    pthread_cond_t  cond;
+    RegItem        *ring;
+    int             cap, cap_max, head, n;
+    int64_t         dropped, drop_log_wc, jump_log_wc;
+    /* the schedule (reader thread only) */
+    int             pcr_pid;
+    int64_t         anchor_t, acc, last_pcr, last_due;
+    int64_t         last_pcr_wc;                    /* T-437: the previous PCR's arrival (wall) */
+    int             pid_moved;                      /* T-439: the PCR just moved PID — its first step is no hole */
+    int64_t         first_wc;                       /* the first packet before any PCR (wall), 0 = said / done */
+    /* 2.2 T-436: [PTV-BURSTY] at the socket (reader thread only) — the demuxer reads the paced loopback and sees none */
+    int64_t         by_last, by_win, by_max, held_min, held_max;
+    int             by_cnt;
+    /* 2.2 T-439: the drift servo + the late-packet report (reader thread only) */
+    int64_t         sv_win, sv_max, sv_rho, sv_frac;
+    int64_t         lt_win, lt_worst;
+    int             lt_cnt, lt_n;
+    /* 2.2 T-441: is the PCR a clock (reader thread only) */
+    int             untrusted;
+    int64_t         tr_win, tr_max, tr_prev, sp_win, rd_last, stop_max;
+    int64_t         bad_wc;                         /* T-444: while untrusted, the last sign that its PCR is no clock */
+    int64_t         retrust;                        /* T-444: REG_RETRUST (PTV_TEST_REG_RETRUST: TEST-ONLY, s) */
+    int             tr_cnt, sp_cnt;
+} Regulator;
+
+static Regulator  *regs[PTV_MAX_INPUT];
+static _Atomic int reg_stop;
+static _Atomic int reg_unreg;                       /* T-444: inputs passing as they arrive now (the status line) */
+
+static int reg_interrupt(void *opaque)
+{
+    (void)opaque;
+    return atomic_load_explicit(&reg_stop, memory_order_relaxed);
+}
+
+/* 2.2 T-436: the arrival-stall report of an unregulated input ([PTV-BURSTY], ptvencoder_demux.c), measured where the
+ * source arrives — a regulated input's demuxer reads the paced loopback, so its own report goes quiet exactly on the
+ * channels that burst. Per 60 s window with a >= 1.5 s stall: the count, the worst, and how much the FIFO held (its
+ * lowest near 0 = D barely covers the gaps). A reopen (outage) restarts the measure, as the demuxer's excludes outages. */
+static void reg_bursty(Regulator *r, int64_t now)
+{
+    int64_t held;
+    if (r->last_due == AV_NOPTS_VALUE)              /* no schedule yet (before the first PCR) */
+        return;
+    held = r->untrusted ? 0 : r->last_due - now;
+    if (r->by_last && now - r->by_last >= 1500000) {
+        r->by_cnt++;
+        r->by_max = FFMAX(r->by_max, now - r->by_last);
+    }
+    r->by_last = now;
+    if (!r->by_win) {
+        r->by_win   = now;
+        r->held_min = r->held_max = held;
+    }
+    r->held_min = FFMIN(r->held_min, held);
+    r->held_max = FFMAX(r->held_max, held);
+    if (now - r->by_win >= 60000000) {
+        if (r->by_cnt > 0 && r->untrusted)
+            av_log(NULL, AV_LOG_INFO, "[PTV-BURSTY] in%d %d stall%s >=1.5s in the last 60s (worst %.1fs) at the input — "
+                   "not regulated (its PCR is no clock)\n", r->k, r->by_cnt, r->by_cnt == 1 ? "" : "s", r->by_max / 1e6);
+        else if (r->by_cnt > 0)
+            av_log(NULL, AV_LOG_INFO, "[PTV-BURSTY] in%d %d stall%s >=1.5s in the last 60s (worst %.1fs) at the input — "
+                   "regulated: %.1f-%.1f s held (D %.1f s)\n", r->k, r->by_cnt, r->by_cnt == 1 ? "" : "s",
+                   r->by_max / 1e6, r->held_min / 1e6, r->held_max / 1e6, r->delay / 1e6);
+        r->by_win = now;
+        r->by_cnt = 0;
+        r->by_max = 0;
+        r->held_min = r->held_max = held;
+    }
+}
+
+/* the packet's 33-bit PCR base when it carries one on the regulated PID, else -1. 2.2 T-439: a PID that carries a PCR
+ * after the regulated one has carried none for 1 s takes over (the provider moved the PCR with its video:
+ * sync_vpidmove_30, 0x100 -> 0x1e1 — the schedule stopped and the input ran unregulated from the move on) */
+static int64_t ts_pcr(Regulator *r, const uint8_t *p, int64_t now)
+{
+    int pid = ((p[1] & 0x1f) << 8) | p[2];
+    if (!(p[3] & 0x20) || p[4] < 7 || !(p[5] & 0x10))
+        return -1;
+    if (r->pcr_pid < 0)
+        r->pcr_pid = pid;
+    if (pid != r->pcr_pid && r->last_pcr_wc && now - r->last_pcr_wc >= 1000000) {
+        av_log(NULL, AV_LOG_INFO, "[PTV-REG] in%d PCR moved: pid 0x%x -> 0x%x (none on 0x%x for %.1f s)\n",
+               r->k, r->pcr_pid, pid, r->pcr_pid, (now - r->last_pcr_wc) / 1e6);
+        r->pcr_pid   = pid;
+        r->pid_moved = 1;
+    }
+    if (pid != r->pcr_pid)
+        return -1;
+    return ((int64_t)p[6] << 25) | (p[7] << 17) | (p[8] << 9) | (p[9] << 1) | (p[10] >> 7);
+}
+
+/* 2.2 T-441: the PCR is no clock to pace by: what is held leaves now, every later packet as it arrives (T-444: until
+ * its PCR is a clock again for REG_RETRUST) */
+static av_printf_format(3, 4) void reg_untrust(Regulator *r, int64_t now, const char *fmt, ...)
+{
+    char msg[128];
+    va_list vl;
+    int i;
+    r->untrusted = 1;
+    r->bad_wc    = now;
+    r->tr_cnt    = r->sp_cnt = 0;
+    atomic_fetch_add_explicit(&reg_unreg, 1, memory_order_relaxed);
+    va_start(vl, fmt);
+    vsnprintf(msg, sizeof msg, fmt, vl);
+    va_end(vl);
+    av_log(NULL, AV_LOG_WARNING, "[PTV-REG] in%d %s — no clock to pace by: the input passes as it arrives (not "
+           "regulated) until its PCR is a clock again for %g min\n", r->k, msg, r->retrust / 6e7);
+    pthread_mutex_lock(&r->lock);
+    for (i = 0; i < r->n; i++)
+        r->ring[(r->head + i) % r->cap].due = 0;
+    pthread_cond_signal(&r->cond);
+    pthread_mutex_unlock(&r->lock);
+}
+
+/* 2.2 T-444: its PCR has been a clock for r->retrust: regulated again from the current packet on, due now; the servo
+ * (wait 0 vs D) slows the schedule and builds the hold up to D */
+static void reg_retrust(Regulator *r, int64_t now)
+{
+    r->untrusted = 0;
+    r->anchor_t  = now;
+    r->acc       = 0;
+    r->last_due  = now;
+    r->sv_win    = r->sv_rho = r->sv_frac = 0;
+    r->tr_win    = r->tr_prev = 0;
+    r->tr_cnt    = r->sp_cnt = 0;
+    r->sp_win    = now;
+    r->lt_win    = 0;
+    r->lt_cnt    = r->lt_n = 0;
+    r->lt_worst  = 0;
+    atomic_fetch_sub_explicit(&reg_unreg, 1, memory_order_relaxed);
+    av_log(NULL, AV_LOG_WARNING, "[PTV-REG] in%d its PCR has been a clock for %g min — regulated again (the hold builds "
+           "up to D %.1f s over ~1 min)\n", r->k, r->retrust / 6e7, r->delay / 1e6);
+}
+
+/* 2.2 T-439: per PCR packet, its wait (due - arrival). The earliest packet of each 10 s should wait D: the servo steers
+ * the schedule's rate toward that. A packet that waits less than -100 ms arrived later than D and passes late (its
+ * jitter is more than D covers): counted, said per 60 s */
+static void reg_servo(Regulator *r, int64_t wait, int64_t now)
+{
+    if (!r->sv_win) {
+        r->sv_win = now;
+        r->sv_max = wait;
+    }
+    r->sv_max = FFMAX(r->sv_max, wait);
+    if (now - r->sv_win >= REG_SV_WIN) {
+        r->sv_rho = av_clip64(-(r->sv_max - r->delay) / REG_SV_TAU, -REG_SV_MAX, REG_SV_MAX);
+        if (getenv("PTV_TEST_REG_NOSERVO"))         /* TEST-ONLY (T-439): the pre-T-439 fixed schedule, for A/B */
+            r->sv_rho = 0;
+        if (g_diag)
+            av_log(NULL, AV_LOG_INFO, "[PTV-REGDIAG] in%d earliest waited %.3f s (D %.3f) rho %+"PRId64"ppm held %d\n",
+                   r->k, r->sv_max / 1e6, r->delay / 1e6, r->sv_rho, r->n);
+        r->sv_win = now;
+        r->sv_max = wait;
+    }
+    /* T-441: the PCR runs ahead of the arrivals faster than the servo follows — per 2 s, the longest wait; three in a row
+     * over D + max(1 s, D / 2), each longer than the last (Heartland: at ~6 s, ~3 s held; at 2 x 10 s it was 9 s held,
+     * the output 3.4 s late for good) */
+    if (!r->tr_win) {
+        r->tr_win = now;
+        r->tr_max = wait;
+    }
+    r->tr_max = FFMAX(r->tr_max, wait);
+    if (now - r->tr_win >= 2000000) {
+        int ahead = r->tr_max - r->delay > FFMAX(1000000, r->delay / 2);
+        if (r->untrusted && ahead)                  /* T-444: still no clock */
+            r->bad_wc = now;
+        else if (!r->untrusted && ahead && r->tr_max > r->tr_prev)
+            r->tr_cnt++;
+        else
+            r->tr_cnt = 0;
+        r->tr_prev = r->tr_max;
+        if (r->tr_cnt >= 3)
+            reg_untrust(r, now, "its PCR runs ahead of the arrivals (the earliest packet waits %.1f s, rising)",
+                        r->tr_max / 1e6);
+        r->tr_win = now;
+        r->tr_max = wait;
+    }
+    if (r->untrusted)                               /* T-444: nothing is held: no packet is late */
+        return;
+    if (!r->lt_win)
+        r->lt_win = now;
+    r->lt_n++;
+    if (wait < -100000) {
+        r->lt_cnt++;
+        r->lt_worst = FFMAX(r->lt_worst, -wait);
+    }
+    if (now - r->lt_win >= 60000000) {
+        if (r->lt_cnt)
+            av_log(NULL, AV_LOG_INFO, "[PTV-REG] in%d %d of %d PCR packets later than D in the last 60s (worst %.1f s "
+                   "past due) — passed as they came (D %.1f s)\n", r->k, r->lt_cnt, r->lt_n, r->lt_worst / 1e6,
+                   r->delay / 1e6);
+        r->lt_win   = now;
+        r->lt_cnt   = r->lt_n = 0;
+        r->lt_worst = 0;
+    }
+}
+
+static void reg_schedule(Regulator *r, int64_t pcr, int64_t now)
+{
+    int64_t stop;
+    if (r->anchor_t != AV_NOPTS_VALUE && now - r->last_pcr_wc > 1000000 && r->stop_max < 1000000) {
+        if (now - r->sp_win >= 60000000) {          /* T-441: the data flowed > 1 s with no PCR */
+            r->sp_win = now;
+            r->sp_cnt = 0;
+        }
+        if (r->untrusted)                           /* T-444: still no clock */
+            r->bad_wc = now;
+        else if (++r->sp_cnt >= 3)
+            reg_untrust(r, now, "its PCR comes only every %.1f s (the spec: 0.1 s)", (now - r->last_pcr_wc) / 1e6);
+    }
+    stop        = r->stop_max;
+    r->stop_max = 0;
+    if (r->anchor_t == AV_NOPTS_VALUE) {
+        r->anchor_t = now + r->delay;
+        r->acc      = 0;
+    } else {
+        int64_t d = pcr - r->last_pcr, gap = now - r->last_pcr_wc, dus;
+        if (d < -(1LL << 32))
+            d += 1LL << 33;                         /* the 33-bit wrap */
+        dus = av_rescale(d, 1000000, 90000);
+        if (d > 90000 && FFABS(gap - dus) <= FFMAX(500000, dus / 4)) {
+            /* 2.2 T-437: the arrivals stopped as long as the PCR jumped — content lost in real time (an origin that skips
+             * a segment: glo-3 SOFAST, a 5.1-5.6 s stop + the same PCR jump every ~30 s, 7 of 7 within 0.02 s). Kept on
+             * its schedule: the hole plays at its moment and the hold stays D. Continuing the schedule here ate the hold at
+             * every hole (a Stingray replay: held 8 -> 163 s, FIFO drops, 13 freezes vs 3 unregulated) */
+            r->acc += d;
+            if (!r->pid_moved && !r->untrusted && now - r->jump_log_wc >= 10000000) {   /* T-444: not the shadow's */
+                r->jump_log_wc = now;
+                av_log(NULL, AV_LOG_INFO, "[PTV-REG] in%d hole %.1f s (the source stopped as long as its PCR jumped) — "
+                       "kept on its schedule (%.1f s held)\n", r->k, dus / 1e6, (r->anchor_t + av_rescale(r->acc, 1000000,
+                       90000) - now) / 1e6);
+            }
+        } else if (d < -9000 || d > 90000) {        /* a jump: continue the schedule (see the top) */
+            /* 2.2 T-443: a step back of less than 0.1 s is the PCR's jitter, not a jump. WB Int / Port (cor-3,
+             * fixture-media/cap-t443-3h) arrive at real time (arrival - PTS within 0.1 s) but their PCR wanders up to
+             * +-1 s against both, in steps of -1.4 to -9.8 ms and +1.06 / +1.17 s, on a packet 0.5-1.9 s behind its
+             * schedule. Taken as a jump there, the schedule restarted at that packet + D; the next packets then waited up
+             * to 2.3 s, rising: a false T-441 'runs ahead', or ~1 s more delay. A jump keeps the schedule (see the top) */
+            r->anchor_t = r->last_due >= now || stop < 1000000 ? r->last_due : now + r->delay;
+            r->acc      = 0;
+            if (!r->untrusted && now - r->jump_log_wc >= 10000000) {
+                r->jump_log_wc = now;
+                av_log(NULL, AV_LOG_INFO, "[PTV-REG] in%d PCR jump %+.1f s — schedule continued (%.1f s held)\n",
+                       r->k, d / 90000.0, (r->anchor_t - now) / 1e6);
+            }
+        } else {
+            r->acc     += d;
+            r->sv_frac += dus * r->sv_rho;          /* T-439: the servo's rate, applied as the PCR advances */
+            r->anchor_t += r->sv_frac / 1000000;
+            r->sv_frac  %= 1000000;
+        }
+    }
+    r->last_pcr    = pcr;
+    r->last_pcr_wc = now;
+    r->pid_moved   = 0;
+    r->last_due    = r->anchor_t + av_rescale(r->acc, 1000000, 90000);
+    reg_servo(r, r->last_due - now, now);
+    if (r->untrusted && now - r->bad_wc >= r->retrust)
+        reg_retrust(r, now);
+}
+
+static void reg_push(Regulator *r, const uint8_t *data, int len, int64_t due)
+{
+    RegItem *it;
+    pthread_mutex_lock(&r->lock);
+    if (r->n == r->cap && r->cap < r->cap_max) {    /* T-439: grow, in order from 0 */
+        int nc = FFMIN(r->cap * 2, r->cap_max), i;
+        RegItem *nr = av_malloc_array(nc, sizeof *nr);
+        if (nr) {
+            for (i = 0; i < r->n; i++)
+                nr[i] = r->ring[(r->head + i) % r->cap];
+            av_free(r->ring);
+            r->ring = nr;
+            r->cap  = nc;
+            r->head = 0;
+        }
+    }
+    if (r->n == r->cap) {                           /* more than D + 10 s held: the oldest go */
+        r->head = (r->head + 1) % r->cap;
+        r->n--;
+        r->dropped++;
+        if (av_gettime_relative() - r->drop_log_wc >= 10000000) {
+            r->drop_log_wc = av_gettime_relative();
+            av_log(NULL, AV_LOG_WARNING, "[PTV-REG] in%d more than %.0f s held — the oldest dropped (%"PRId64" so far)\n",
+                   r->k, r->delay / 1e6 + 10, r->dropped);
+        }
+    }
+    it = &r->ring[(r->head + r->n) % r->cap];
+    it->due = due;
+    it->len = len;
+    memcpy(it->data, data, len);
+    r->n++;
+    pthread_cond_signal(&r->cond);
+    pthread_mutex_unlock(&r->lock);
+}
+
+static void *reg_reader(void *arg)
+{
+    Regulator *r = arg;
+    AVIOInterruptCB icb = { reg_interrupt, NULL };
+    uint8_t buf[65536], dg[REG_DGRAM];
+    int have = 0, dl = 0;
+    int64_t due = AV_NOPTS_VALUE;
+    while (!atomic_load_explicit(&reg_stop, memory_order_relaxed)) {
+        AVIOContext *pb = NULL;
+        int ret = avio_open2(&pb, r->src_url, AVIO_FLAG_READ, &icb, NULL);
+        if (ret < 0) {
+            av_usleep(1000000);
+            continue;
+        }
+        while (!atomic_load_explicit(&reg_stop, memory_order_relaxed)) {
+            int n = avio_read_partial(pb, buf + have, sizeof(buf) - have), i = 0;
+            int64_t now = av_gettime_relative();
+            if (n <= 0)
+                break;                              /* a read error / the source's timeout: reopen */
+            reg_bursty(r, now);
+            if (r->rd_last)                         /* T-441: the longest arrival stop since the last PCR */
+                r->stop_max = FFMAX(r->stop_max, now - r->rd_last);
+            r->rd_last = now;
+            have += n;
+            while (have - i >= 188) {
+                const uint8_t *p = buf + i;
+                int64_t pcr;
+                if (p[0] != 0x47) {                 /* resync on the next sync byte */
+                    i++;
+                    continue;
+                }
+                if ((pcr = ts_pcr(r, p, now)) >= 0) {
+                    if (dl) {                       /* a PCR'd packet starts a new datagram at its own time */
+                        reg_push(r, dg, dl, due);
+                        dl = 0;
+                    }
+                    reg_schedule(r, pcr, now);      /* T-444: also while untrusted — is it a clock again? */
+                    due = r->last_due;
+                }
+                if (r->untrusted)
+                    due = now;                      /* T-441: as it arrives */
+                if (due == AV_NOPTS_VALUE) {
+                    due = now + r->delay;           /* before the first PCR: held by D */
+                    r->first_wc = now;
+                } else if (r->pcr_pid < 0 && r->first_wc && now - r->first_wc > 5000000) {
+                    r->first_wc = 0;                /* no PCR to schedule by: passed through after D, said once */
+                    av_log(NULL, AV_LOG_WARNING, "[PTV-REG] in%d no PCR in 5 s — passing the input through (delayed "
+                           "%.1f s, not regulated)\n", r->k, r->delay / 1e6);
+                }
+                memcpy(dg + dl, p, 188);
+                dl += 188;
+                if (dl == REG_DGRAM) {
+                    reg_push(r, dg, dl, due);
+                    dl = 0;
+                }
+                i += 188;
+            }
+            memmove(buf, buf + i, have - i);
+            have -= i;
+        }
+        avio_closep(&pb);
+        have = 0;
+        r->by_last = 0;                             /* T-436: an outage is not a stall */
+        r->rd_last  = 0;                            /* T-441: nor a sparse PCR */
+        r->stop_max = INT64_MAX / 2;
+    }
+    return NULL;
+}
+
+static void *reg_writer(void *arg)
+{
+    Regulator *r = arg;
+    struct sockaddr_in to = { 0 };
+    int fd = socket(AF_INET, SOCK_DGRAM, 0);
+    if (fd < 0)
+        return NULL;
+    to.sin_family      = AF_INET;
+    to.sin_port        = htons(r->port);
+    to.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    while (!atomic_load_explicit(&reg_stop, memory_order_relaxed)) {
+        RegItem it;
+        int64_t wait;
+        pthread_mutex_lock(&r->lock);
+        if (!r->n) {
+            struct timespec ts;
+            int64_t t = av_gettime() + 50000;
+            ts.tv_sec  = t / 1000000;
+            ts.tv_nsec = (t % 1000000) * 1000;
+            pthread_cond_timedwait(&r->cond, &r->lock, &ts);
+            pthread_mutex_unlock(&r->lock);
+            continue;
+        }
+        wait = r->ring[r->head].due - av_gettime_relative();
+        if (wait > 0) {
+            pthread_mutex_unlock(&r->lock);
+            av_usleep(FFMIN(wait, 5000));
+            continue;
+        }
+        it = r->ring[r->head];
+        r->head = (r->head + 1) % r->cap;
+        r->n--;
+        pthread_mutex_unlock(&r->lock);
+        sendto(fd, it.data, it.len, 0, (struct sockaddr *)&to, sizeof to);
+    }
+    close(fd);
+    return NULL;
+}
+
+/* a free loopback UDP port (bound and released: the input binds it next) */
+static int reg_port(void)
+{
+    struct sockaddr_in a = { 0 };
+    socklen_t al = sizeof a;
+    int fd = socket(AF_INET, SOCK_DGRAM, 0), port = -1;
+    if (fd < 0)
+        return -1;
+    a.sin_family      = AF_INET;
+    a.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    if (!bind(fd, (struct sockaddr *)&a, sizeof a) && !getsockname(fd, (struct sockaddr *)&a, &al))
+        port = ntohs(a.sin_port);
+    close(fd);
+    return port;
+}
+
+char *ptv_regulate_start(const char *url, int64_t delay_us, int k)
+{
+    Regulator *r;
+    const char *q;
+    char *out, *opts, *tok, *save = NULL;
+    AVBPrint bp;
+    if (!url || strncmp(url, "udp://", 6) || k < 0 || k >= PTV_MAX_INPUT || delay_us <= 0)
+        return NULL;
+    if (!(r = av_mallocz(sizeof *r)))
+        return NULL;
+    r->k        = k;
+    r->delay    = delay_us;
+    r->pcr_pid  = -1;
+    r->anchor_t = AV_NOPTS_VALUE;
+    r->last_due = AV_NOPTS_VALUE;                   /* T-436: no schedule yet */
+    r->retrust  = getenv("PTV_TEST_REG_RETRUST") ? atoi(getenv("PTV_TEST_REG_RETRUST")) * 1000000LL : REG_RETRUST;
+    r->cap_max  = (int)((delay_us / 1000000 + 10) * 2000);   /* D + 10 s at up to ~20 Mb/s */
+    r->cap      = FFMIN(REG_CAP0, r->cap_max);      /* T-439: grows as it fills */
+    r->port     = reg_port();
+    r->src_url  = av_strdup(url);
+    r->ring     = av_malloc_array(r->cap, sizeof *r->ring);
+    if (r->port < 0 || !r->src_url || !r->ring)
+        goto fail;
+    /* the input reads the loopback port with the source's own options, less the ones that name the source's network */
+    av_bprint_init(&bp, 0, AV_BPRINT_SIZE_UNLIMITED);
+    av_bprintf(&bp, "udp://127.0.0.1:%d", r->port);
+    if ((q = strchr(url, '?')) && (opts = av_strdup(q + 1))) {
+        char sep = '?';
+        for (tok = av_strtok(opts, "&", &save); tok; tok = av_strtok(NULL, "&", &save)) {
+            if (av_strstart(tok, "localaddr=", NULL) || av_strstart(tok, "reuse=", NULL) ||
+                av_strstart(tok, "sources=", NULL) || av_strstart(tok, "block=", NULL))
+                continue;
+            av_bprintf(&bp, "%c%s", sep, tok);
+            sep = '&';
+        }
+        av_free(opts);
+    }
+    if (av_bprint_finalize(&bp, &out) < 0)
+        goto fail;
+    pthread_mutex_init(&r->lock, NULL);
+    pthread_cond_init(&r->cond, NULL);
+    r->rd_ok = !pthread_create(&r->rd, NULL, reg_reader, r);
+    r->wr_ok = !pthread_create(&r->wr, NULL, reg_writer, r);
+    regs[k] = r;
+    av_log(NULL, AV_LOG_INFO, "[PTV-REG] in%d regulated: %s → %s, released at PCR time + %.1f s\n",
+           k, url, out, delay_us / 1e6);
+    return out;
+fail:
+    av_free(r->src_url);
+    av_free(r->ring);
+    av_free(r);
+    return NULL;
+}
+
+int ptv_regulate_unregulated(void)
+{
+    return atomic_load_explicit(&reg_unreg, memory_order_relaxed);
+}
+
+void ptv_regulate_stop(void)
+{
+    int k;
+    atomic_store_explicit(&reg_stop, 1, memory_order_relaxed);
+    for (k = 0; k < PTV_MAX_INPUT; k++) {
+        Regulator *r = regs[k];
+        if (!r)
+            continue;
+        pthread_mutex_lock(&r->lock);
+        pthread_cond_broadcast(&r->cond);
+        pthread_mutex_unlock(&r->lock);
+        if (r->rd_ok) pthread_join(r->rd, NULL);
+        if (r->wr_ok) pthread_join(r->wr, NULL);
+        pthread_mutex_destroy(&r->lock);
+        pthread_cond_destroy(&r->cond);
+        av_free(r->src_url);
+        av_free(r->ring);
+        av_freep(&regs[k]);
+    }
+}
diff --git a/fftools/ptvencoder_timeline.c b/fftools/ptvencoder_timeline.c
new file mode 100644
index 0000000000..cf8a952e22
--- /dev/null
+++ b/fftools/ptvencoder_timeline.c
@@ -0,0 +1,839 @@
+/*
+ * ptvencoder — 2.1 T-409: the program timeline, source stage (M_in).
+ *
+ * ONE classifier per input decides every source timing event and applies ONE remedy to every stream of the input
+ * (design: analysis/t409-timeline-map-design.md). Since 2.1.0 it is the only path: it replaces the demux absorber, the
+ * wall-evidence split, the LAYERA buffer and the door's downstream re-discovery of its own cut (their code stays, not
+ * run, until the 2.1 canary soak — design §7 P5 — then it is deleted).
+ *
+ * The remedy is the program offset k: every packet of the input leaves the demux labelled L = S + k, S = its source
+ * time after the 33-bit unwrap. k is realized through the existing offset state — wrap_off[] of every dense stream and
+ * prog_off of the sparse ones (so SCTE-35 pts_adjustment and the copies follow unchanged) — and only this file writes it
+ * (one writer). An event changes k by whole pictures, for all streams at once: after the demux, the labels of every
+ * stream are continuous except at holes deliberately kept.
+ *
+ * An event: the first dense packet more than PTV_TL_OPEN_MS off its stream's path opens a window; every packet of the
+ * input is held until each flowing dense stream has resolved (crossed to a new path, come back to the old one, or
+ * passed the crossing point without crossing) or the window times out. Then, once:
+ *   - packets off every path that do not continue (one corrupt PES, the first piece of a split step) are dropped;
+ *   - the video and at least one audio crossed by the same amount: a PROGRAM event. J = the video's step on its picture
+ *     grid; W = the input's wall silence before it (no evidence under an armed bank / deep prime), or under damage the
+ *     damage phase's duration if longer. keep = min(J, W) in whole pictures (a step back after a wall gap = a new domain: keep W),
+ *     erase = J − keep, k −= erase. The sound after the last
+ *     old picture and before the first new one is dropped; the audio's sub-frame rest is the audio's own continuity;
+ *   - only one stream crossed: a single-stream step, labels as sent (the content path pads / trims, RELABEL may repair).
+ */
+
+#include "ptvencoder.h"
+#include "libavutil/mathematics.h"
+#include "libavutil/time.h"
+
+#define TL_HELD_MAX   4096
+#define TL_WIN_US     1000000       /* an event window closes 1 s after its last partner's first packet at the latest */
+#define TL_WIN_SIL_US 3000000       /* ... or 3 s while a flowing partner has delivered nothing since it opened (T-431) */
+#define TL_PASS_US    300000        /* a partner whose own timeline passed the crossing point by this did not cross */
+#define TL_STRAG_US   2000000       /* after an event, packets on a stream's old path are stragglers for this long */
+#define TL_BIG_US     2000000       /* 2.2 T-451: a step beyond this is no relabel (the repair bound): a program-wide step */
+#define TL_SAME_US    1000000       /* 2.2 T-451: the audio of a program event crossed by the video's J within this */
+
+typedef struct TlPkt {
+    AVPacket *pkt;
+    int64_t   s_us;    /* source time (DTS, or PTS when no DTS), us; AV_NOPTS_VALUE = none */
+    int64_t   k_at;    /* the k its labels were given by demux_unwrap */
+    int64_t   wc;      /* arrival wall */
+    int       si;
+    int       path;    /* 0 old, 1 new, 2 drop */
+} TlPkt;
+
+typedef struct TlStream {
+    int     dense, ok;
+    int64_t last_us, step_us, last_wc;
+    int64_t strag_last_us, strag_until_wc;   /* the old path after an event (stragglers are dropped) */
+    /* classification scratch */
+    int     res;        /* 0 unresolved/old, 1 crossed, 2 came back (outlier) */
+    int64_t old_end_us, new_first_us, new_last_us;
+    int     new_n;
+    int     win_passed;                       /* the video went on on its old path during this window (dispatched) */
+    int64_t pass_wc;                          /* T-433: its last wall time before a stale old-path picture that ended a
+                                               * silence in this window (0 = none) — W keeps the silence */
+    int64_t rep_us, rep_new;                  /* label repair held on this stream (us) / this window's change of it */
+    int     rl_mark;                          /* flag the first repaired packet for the T-087 content check */
+} TlStream;
+
+struct PtvTimeline {
+    int64_t   k_us;
+    int64_t   ev_n, strag_n, drop_n;
+    int       active, trig, nst, cap;   /* nst = streams followed; cap = st[] room (2.2: adoption) */
+    int       win_big;                  /* T-451: the trigger stepped more than TL_BIG_US */
+    int64_t   open_wc, open_s_us;
+    int64_t   open_pos, open_vn;                 /* T-332: the opening packet's mux position, video packets unwrapped */
+    int64_t   last_any_wc, gap_us, gap_end_wc;   /* the input's last silence >= g_gap_min_us */
+    int64_t   dmg_seen_wc, dmg_start_wc;         /* the input's damage phase: corrupt packets <= 3 s apart */
+    int64_t   er_lo, er_hi;                      /* source time the last program event erased (audio arriving late) */
+    int64_t   ev_va, ev_dk, ev_wc;               /* the last program event: old content ends at ev_va; its offset move */
+    _Atomic int64_t prog_wc;                     /* wall time of the last program event (read by the copy path) */
+    TlStream *st;
+    TlPkt     held[TL_HELD_MAX];
+    int       nheld;
+};
+
+int64_t g_tl_open_us = 500000;
+
+PtvTimeline *ptv_tl_alloc(int nb_streams, int cap)
+{
+    PtvTimeline *t = av_mallocz(sizeof(*t));
+    if (!t)
+        return NULL;
+    t->cap = FFMAX(cap, nb_streams);
+    t->st = av_calloc(FFMAX(t->cap, 1), sizeof(*t->st));
+    if (!t->st) {
+        av_free(t);
+        return NULL;
+    }
+    t->nst = nb_streams;
+    return t;
+}
+
+void ptv_tl_grow(PtvTimeline *t, int nb_streams)
+{
+    if (t && nb_streams > t->nst && nb_streams <= t->cap)
+        t->nst = nb_streams;                   /* the new slot is zeroed: a stream that has not started */
+}
+
+void ptv_tl_free(PtvTimeline **pt)
+{
+    PtvTimeline *t = *pt;
+    int i;
+    if (!t)
+        return;
+    for (i = 0; i < t->nheld; i++)
+        av_packet_free(&t->held[i].pkt);
+    av_free(t->st);
+    av_freep(pt);
+}
+
+static int is_dense(const DemuxArgs *d, int si)
+{
+    int ct = d->ifmt->streams[si]->codecpar->codec_type;
+    return ct == AVMEDIA_TYPE_VIDEO || ct == AVMEDIA_TYPE_AUDIO;
+}
+
+static int64_t pkt_s_us(const DemuxArgs *d, const AVPacket *p, int64_t k_us)
+{
+    int64_t ts = p->dts != AV_NOPTS_VALUE ? p->dts : p->pts;
+    if (ts == AV_NOPTS_VALUE)
+        return AV_NOPTS_VALUE;
+    return av_rescale_q(ts, d->ifmt->streams[p->stream_index]->time_base, AV_TIME_BASE_Q) - k_us;
+}
+
+static int64_t pkt_dur_us(const DemuxArgs *d, const AVPacket *p)
+{
+    const AVStream *st = d->ifmt->streams[p->stream_index];
+    if (p->duration > 0)
+        return av_rescale_q(p->duration, st->time_base, AV_TIME_BASE_Q);
+    if (st->codecpar->codec_type == AVMEDIA_TYPE_VIDEO && st->avg_frame_rate.num > 0)
+        return av_rescale(AV_TIME_BASE, st->avg_frame_rate.den, st->avg_frame_rate.num);
+    if (st->codecpar->sample_rate > 0 && st->codecpar->frame_size > 0)
+        return av_rescale(AV_TIME_BASE, st->codecpar->frame_size, st->codecpar->sample_rate);
+    return 0;
+}
+
+static int64_t tol_us(const TlStream *s)
+{
+    /* two of the stream's own steps: a backward step of 3 pictures (gate sync_bstep -120 ms at 25p) leaves the path */
+    return av_clip64(2 * s->step_us, 40000, g_tl_open_us / 2);
+}
+
+/* a window's 1 s runs on live input: an input silence inside it restarts it, so every stream can still cross after the
+ * input returns. Decided while the input was silent, an audio-first crossing went out as a single-stream step with the old
+ * offset and the video's erase a moment later left it 16.8 s off its pictures (sync_storm 430 s) */
+static int64_t win_from(const PtvTimeline *t)
+{
+    return FFMAX(t->open_wc, t->gap_end_wc);
+}
+
+/* a packet off its stream's path by this opens a window: forward the open threshold (smaller forward steps are the
+ * stream's loss, padded), backward from g_aglue_ms — the demux absorber's backward band (80 ms) that the timeline replaces;
+ * a both-stream step of -120 ms passed unclassified (copied subtitles / SCTE-35 / teletext 2 frames off its picture) */
+static int off_path(const TlStream *s, int64_t s_us)
+{
+    int64_t dev = s_us - (s->last_us + s->step_us);
+    return dev > g_tl_open_us || dev < -FFMAX((int64_t)g_aglue_ms * 1000, tol_us(s));
+}
+
+/* the normal-path bookkeeping of a packet on its stream's path */
+static void path_take(TlStream *s, int64_t s_us, int64_t wc)
+{
+    if (s->ok) {
+        int64_t dl = s_us - s->last_us;
+        /* the stream's own cadence: only deltas near it (a gap must not teach it — one 192 ms burst seam on 21 ms AAC
+         * made every following frame read 171 ms behind, and the relabel repair ran away: +0.17 s per frame, cap-nmx) */
+        if (dl > 0 && dl <= 250000 && (!s->step_us || (dl > s->step_us / 2 && dl < 2 * s->step_us)))
+            s->step_us = s->step_us ? s->step_us + (dl - s->step_us) / 8 : dl;
+    }
+    s->last_us = s_us;
+    s->last_wc = wc;
+    s->ok      = 1;
+}
+
+/* shift a packet's labels from the k it was given to k_to */
+static void relabel(const DemuxArgs *d, AVPacket *p, int64_t k_from, int64_t k_to)
+{
+    const AVStream *st = d->ifmt->streams[p->stream_index];
+    int64_t dl;
+    if (k_to == k_from)
+        return;
+    dl = av_rescale_q(k_to - k_from, AV_TIME_BASE_Q, st->time_base);
+    if (p->pts != AV_NOPTS_VALUE) p->pts += dl;
+    if (p->dts != AV_NOPTS_VALUE) p->dts += dl;
+}
+
+/* move the program offset: every dense stream's wrap_off and the sparse streams' prog_off, both edit ledgers alike */
+static void k_move(DemuxArgs *d, PtvTimeline *t, int64_t dk_us)
+{
+    unsigned s;
+    if (!dk_us)
+        return;
+    for (s = 0; s < d->ifmt->nb_streams && s < (unsigned)d->nb_streams_open; s++) {
+        if (!is_dense(d, s))
+            continue;
+        d->wrap_off[s] += av_rescale_q(dk_us, AV_TIME_BASE_Q, d->ifmt->streams[s]->time_base);
+        ptv_rsync_post_edit(d, s, dk_us);
+    }
+    d->prog_off += av_rescale_q(dk_us, AV_TIME_BASE_Q, (AVRational){ 1, 90000 });
+    t->k_us     += dk_us;
+}
+
+/* Walk one stream's held packets (arrival order) against its path: mark old / new (the run it ends on) / drop (runs
+ * that do not continue). Fills the scratch fields; returns the stream's resolution. `final` = the window is closing. */
+static int classify_stream(PtvTimeline *t, int si, int final, int64_t cross_s_us)
+{
+    TlStream *s = &t->st[si];
+    int64_t old_last = s->last_us, step = s->step_us ? s->step_us : 20000, tol = tol_us(s);
+    int64_t run_first = AV_NOPTS_VALUE, run_last = AV_NOPTS_VALUE, run_base = AV_NOPTS_VALUE;
+    int run_n = 0, i, back_n = 0, seen = 0, ended_old = 0;
+
+    s->res = 0; s->new_n = 0; s->old_end_us = old_last;
+    for (i = 0; i < t->nheld; i++) {
+        TlPkt *h = &t->held[i];
+        if (h->si != si || h->s_us == AV_NOPTS_VALUE)
+            continue;
+        seen++;
+        /* a run that goes on at its own cadence stays the run where it crosses the old path's expected position: a
+         * program-wide step back of a few pictures overlaps the old labels (gate sync_bstep -120 ms read as an outlier, its
+         * first pictures dropped). A corrupt run that returns jumps back — it does not continue itself */
+        if (run_n && llabs(h->s_us - (run_last + step)) <= tol) {
+            h->path = 1;
+            run_last = h->s_us;
+            run_n++;
+            ended_old = 0;
+            continue;
+        }
+        if (!s->ok || llabs(h->s_us - (old_last + step)) <= tol) {
+            h->path = 0;
+            old_last = h->s_us;
+            ended_old = 1;
+            if (run_n)
+                back_n++;
+            continue;
+        }
+        ended_old = 0;
+        /* a new run: an earlier one did not continue */
+        if (run_n) {
+            int j;
+            for (j = 0; j < i; j++)
+                if (t->held[j].si == si && t->held[j].path == 1)
+                    t->held[j].path = 2;
+        }
+        h->path   = 1;
+        run_first = run_last = h->s_us;
+        run_base  = old_last;
+        run_n     = 1;
+        back_n    = 0;
+    }
+    /* a lone packet after an input silence whose jump the silence explains (J ~ W: live content resuming between two
+     * outages of a storm) is no corrupt outlier — the wall clock corroborates it (sync_storm 430 s: such scraps dropped,
+     * and the next event merged two holes into one J against one W) */
+    if (final && run_n == 1 && !ended_old && t->gap_us >= g_gap_min_us &&
+        llabs((run_first - (run_base + step)) - t->gap_us) <= FFMAX(1000000, t->gap_us / 10)) {
+        s->res          = 1;
+        s->old_end_us   = run_base;
+        s->new_first_us = run_first;
+        s->new_last_us  = run_last;
+        s->new_n        = 1;
+        return 1;
+    }
+    if (run_n && (ended_old || (final && run_n < 2))) {
+        /* came back to the old path (or a lone packet at the end): the run was corrupt */
+        for (i = 0; i < t->nheld; i++)
+            if (t->held[i].si == si && t->held[i].path == 1)
+                t->held[i].path = 2;
+        s->res = back_n || final ? 2 : 0;
+        s->old_end_us = old_last;
+        return s->res;
+    }
+    if (run_n >= 2 || (final && run_n)) {
+        s->res          = 1;
+        s->old_end_us   = run_base;
+        s->new_first_us = run_first;
+        s->new_last_us  = run_last;
+        s->new_n        = run_n;
+        return 1;
+    }
+    if (run_n)
+        return 0;                              /* one packet off: wait for the next */
+    s->old_end_us = old_last;
+    /* never left its path: resolved "did not cross" once its own time passed the crossing point. 2.2 T-451: not on a big
+     * step — a partner going on on its old path for a while is how a source's streams cross a clock step apart (cor-3
+     * Curiosity 2026-11-07: the audio stepped -14768 s, the video 1.03 s later; decided "did not cross" at 300 ms, the
+     * step went out as two single-stream steps and the joint return 2 s later was erased: output 4 h off). It waits for
+     * the window (TL_WIN_SIL_US) — a big step on one stream alone is no relabel either way. Not past TL_BIG_US beyond the
+     * crossing point: that partner flowed through the time the step skipped (gate sync_vnull_20: the video nulled 20 s,
+     * its last PES handed over only when it resumed — its own silence read ~0, the step "big" — and the window held all
+     * streams 3 s for an audio 20 s past the crossing: content age +2 s, 3 flashes without their beep) */
+    if (cross_s_us != AV_NOPTS_VALUE && (seen || s->win_passed) && old_last > cross_s_us + TL_PASS_US &&
+        (!t->win_big || old_last > cross_s_us + TL_BIG_US))
+        return 3;
+    return 0;
+}
+
+/* a stream was flowing if it delivered within 2 s of the input's last activity before the event (before the silence
+ * the window opened behind, if any) */
+static int flowing(const PtvTimeline *t, const TlStream *s)
+{
+    int64_t ref = t->gap_end_wc && t->open_wc - t->gap_end_wc <= 1000000 ? t->gap_end_wc - t->gap_us : t->open_wc;
+    return s->dense && s->ok && ref - s->last_wc <= 2000000;
+}
+
+/* 2.2 T-433: the video decides a program event (close_window), so a window an audio stream opens waits for a silent video
+ * too (up to TL_WIN_SIL_US, evidence_from), not only for a video that flowed just before the input fell silent — cor-3
+ * Azorse_TV 2026-10-31: the source died in a trickle, its video ~3 s before its audio, and both came back -43210 s with the
+ * audio 1 s first: the audio closed its window at once alone, two single-stream steps "labels as sent", output audio dead
+ * 6 min (sync_check restart) */
+static int partner(const DemuxArgs *d, const PtvTimeline *t, int si)
+{
+    const TlStream *s = &t->st[si];
+    return flowing(t, s) || (si == d->vstream && si != t->trig && s->dense && s->ok);
+}
+
+static int has_held(const PtvTimeline *t, int si)
+{
+    int i;
+    for (i = 0; i < t->nheld; i++)
+        if (t->held[i].si == si && t->held[i].s_us != AV_NOPTS_VALUE)
+            return 1;
+    return 0;
+}
+
+/* 2.2 T-431: a partner that flowed before the event but has delivered nothing since the window opened is no evidence either
+ * way — closing at 1 s took its silence as "did not cross" (live-transcoder Fashion 2026-10-30: the video came back
+ * -10312.9 s, the audio was silent 1.26 s at the return; the video went out as a single-stream step, labels as sent,
+ * house_skew +4785 s). The window's 1 s runs from the latest flowing partner's first packet in it (its own evidence: one
+ * packet at the close reads as a lone outlier), up to TL_WIN_SIL_US in all; INT64_MAX = a partner still silent */
+static int64_t evidence_from(const DemuxArgs *d, const PtvTimeline *t)
+{
+    int64_t from = win_from(t);
+    int si, i;
+    for (si = 0; si < t->nst; si++) {
+        const TlStream *s = &t->st[si];
+        if (si == t->trig || !partner(d, t, si))
+            continue;
+        /* T-433: a video going on on its old path (dispatched) is its own evidence from its latest picture — it resolves
+         * the window once its time passes the crossing point (window_resolved). Skipped, one stale picture of the old
+         * content arriving in the window (Azorse: the dying source's last trickle) closed it at 1 s before the video's
+         * own crossing */
+        if (si == d->vstream && s->win_passed && !has_held(t, si)) {
+            from = FFMAX(from, s->last_wc);
+            continue;
+        }
+        for (i = 0; i < t->nheld && t->held[i].si != si; i++)
+            ;
+        if (i == t->nheld)
+            return INT64_MAX;
+        from = FFMAX(from, t->held[i].wc);
+    }
+    return from;
+}
+
+static int window_over(const DemuxArgs *d, const PtvTimeline *t, int64_t nw)
+{
+    int64_t ev = evidence_from(d, t);
+    if (t->win_big)                            /* T-451: a big step waits for its partners up to the full window */
+        return nw - win_from(t) >= TL_WIN_SIL_US;
+    return nw - win_from(t) >= TL_WIN_SIL_US || (ev != INT64_MAX && nw - ev >= TL_WIN_US);
+}
+
+static int window_resolved(DemuxArgs *d, PtvTimeline *t, int final)
+{
+    int si, all = 1, r;
+    int64_t cross = AV_NOPTS_VALUE;
+    r = classify_stream(t, t->trig, final, AV_NOPTS_VALUE);
+    if (r == 1) {
+        const TlStream *ts = &t->st[t->trig];
+        cross = ts->old_end_us;
+        /* big = a step the input's wall silence does not explain: any step back beyond TL_BIG_US, a forward step beyond
+         * the trigger's own silence by more. A hole (J ~ W) is no relabel: its window closes on its evidence as before
+         * (rc3 verification: a 10 s gap held 3 s for a partner it never needed — 305 packets, A/V PID dark 3.1 s and
+         * flashes without their beep on sync_gap / ac3_gap). No wall evidence (armed bank / deep prime): backward only */
+        int64_t jt = ts->new_first_us - (ts->old_end_us + (ts->step_us ? ts->step_us : 20000));
+        int     nowall = atomic_load_explicit(&g_bank_us, memory_order_relaxed) > 0 || (int64_t)g_preroll_ms >= 4000;
+        int64_t wt = FFMAX(ts->last_wc ? t->open_wc - ts->last_wc : 0,
+                           t->gap_end_wc && t->open_wc - t->gap_end_wc <= 1000000 ? t->gap_us : 0);
+        t->win_big = jt < -TL_BIG_US || (!nowall && jt - wt > TL_BIG_US);
+    }
+    else if (r != 2)
+        return final;
+    if (r == 2)
+        return 1;                              /* the trigger was one corrupt run: nothing else to wait for */
+    for (si = 0; si < t->nst; si++) {
+        TlStream *s = &t->st[si];
+        if (si == t->trig || !s->dense)
+            continue;
+        if (!partner(d, t, si) && !(final && has_held(t, si)))
+            continue;                          /* not flowing before the event: no partner to wait for */
+        r = classify_stream(t, si, final, cross);
+        if (r == 0 && partner(d, t, si))
+            all = 0;
+    }
+    return all || final;
+}
+
+static int64_t input_wall_gap(PtvTimeline *t, int64_t first_new_wc)
+{
+    int64_t w = 0, prev = AV_NOPTS_VALUE;
+    int i;
+    if (t->gap_end_wc && t->open_wc - t->gap_end_wc <= 1000000)
+        w = t->gap_us;                         /* the silence the window opened behind (the PES tail came first) */
+    for (i = 0; i < t->nheld && t->held[i].wc <= first_new_wc; i++) {
+        if (prev != AV_NOPTS_VALUE && t->held[i].wc - prev > w)
+            w = t->held[i].wc - prev;
+        prev = t->held[i].wc;
+    }
+    return w >= g_gap_min_us ? w : 0;
+}
+
+static int release(DemuxArgs *d, PtvTimeline *t, int64_t k_old, int64_t k_new, int prog_event,
+                   int64_t va_us, int64_t vb_us)
+{
+    int i, ret = 0;
+    for (i = 0; i < t->nheld; i++) {
+        TlPkt *h = &t->held[i];
+        AVPacket *p = h->pkt;
+        int64_t k = k_old;
+        h->pkt = NULL;
+        if (h->path == 2) {
+            t->drop_n++;
+            av_packet_free(&p);
+            continue;
+        }
+        if (h->s_us != AV_NOPTS_VALUE && h->si < t->nst && t->st[h->si].dense) {
+            if (h->path == 1 && t->st[h->si].res == 1) {
+                k = k_new + t->st[h->si].rep_new;   /* labels + repair (relabel adds k_to - k_from) */
+                if (t->st[h->si].rl_mark) {
+                    p->flags |= PTV_PKT_FLAG_RELABEL;
+                    t->st[h->si].rl_mark = 0;
+                }
+            }
+            if (prog_event && d->ifmt->streams[h->si]->codecpar->codec_type == AVMEDIA_TYPE_AUDIO) {
+                int64_t end = h->s_us + pkt_dur_us(d, p);
+                /* the sound after the last old picture / before the first new one belongs to the erased span */
+                if ((k == k_old && h->s_us >= va_us) || (k == k_new && end <= vb_us)) {
+                    t->drop_n++;
+                    av_packet_free(&p);
+                    continue;
+                }
+            }
+        } else if (prog_event && h->s_us != AV_NOPTS_VALUE) {
+            /* sparse: the nearer side; held in a step-back window they were read after the step began: the new one */
+            k = vb_us < va_us || llabs(h->s_us - vb_us) < llabs(h->s_us - va_us) ? k_new : k_old;
+        }
+        relabel(d, p, h->k_at, k);
+        if (ret >= 0)
+            ret = ptv_demux_dispatch(d, p);
+        else
+            av_packet_free(&p);
+    }
+    t->nheld = 0;
+    return ret;
+}
+
+static int close_window(DemuxArgs *d, PtvTimeline *t)
+{
+    int si, vs = d->vstream, n_aud_cross = 0, n_aud_flow = 0, prog_event = 0, dmg = 0;
+    int64_t k_old = t->k_us, k_new = t->k_us, J = 0, W = 0, keep = 0, erase = 0, fd = 0, dspan = 0;
+    int64_t va = AV_NOPTS_VALUE, vb = AV_NOPTS_VALUE, first_new_wc = INT64_MAX, nw = av_gettime_relative();
+    const char *cls = "outlier";
+    /* T-431: a partner silent through the whole TL_WIN_SIL_US window no longer flows — no partner to wait for (a video
+     * that crossed alone is then a program event, as with no audio flowing); its next packet re-seeds its path */
+    int sil_out = nw - win_from(t) >= TL_WIN_SIL_US;
+    int ret;
+
+    window_resolved(d, t, 1);
+    for (si = 0; si < t->nst; si++) {
+        TlStream *s = &t->st[si];
+        if (!s->dense || si == vs)
+            continue;
+        if (d->ifmt->streams[si]->codecpar->codec_type == AVMEDIA_TYPE_AUDIO && ((flowing(t, s) && !sil_out) || has_held(t, si)))
+            n_aud_flow++;
+        /* 2.2 T-451: a partner of a program event crossed by the video's amount — an audio crossing the other way in the
+         * same window (its return leg while the video's step arrives) is no partner: taken as one, the video's -14768 s
+         * departure and the audio's +14768 s return made a "step back erased" (sync_excursion: audio dead after) */
+        if (s->res == 1 && vs >= 0 && vs < t->nst && t->st[vs].res == 1) {
+            const TlStream *v = &t->st[vs];
+            int64_t jv = v->new_first_us - (v->old_end_us + (v->step_us ? v->step_us : 20000));
+            int64_t ja = s->new_first_us - (s->old_end_us + (s->step_us ? s->step_us : 20000));
+            if (llabs(ja - jv) <= FFMAX(TL_SAME_US, llabs(jv) / 1000))
+                n_aud_cross++;
+        } else if (s->res == 1)
+            n_aud_cross++;
+    }
+    for (si = 0; si < t->nheld; si++)
+        if (t->held[si].path == 1 && t->held[si].wc < first_new_wc)
+            first_new_wc = t->held[si].wc;
+    if (vs >= 0 && vs < t->nst && t->st[vs].res == 1 && (n_aud_cross || !n_aud_flow)) {
+        const AVStream *vst = d->ifmt->streams[vs];
+        TlStream *v = &t->st[vs];
+        int64_t vlw;
+        fd = vst->avg_frame_rate.num > 0 ? av_rescale(AV_TIME_BASE, vst->avg_frame_rate.den, vst->avg_frame_rate.num)
+                                         : FFMAX(v->step_us, 1);
+        va = v->old_end_us + fd;               /* the end of the last old picture */
+        vb = v->new_first_us;                  /* the first new picture */
+        J  = vb - va;          /* exact: an erase makes the labels continuous (the first new picture one picture after the
+                                * last old one = on the grid); only the KEPT part is whole pictures. Rounding J to pictures
+                                * over-erased a sub-picture relabel (29.97: -120 ms read -133 ms) — a skipped tick, a 0.07 s
+                                * video PTS hole per event (sync_bstep rich2997b) */
+        /* W over the same span as J: J runs from the video's last old-path picture, so W counts from when that picture
+         * arrived too — not only the latest silence. A content scrap between two outages, dropped as an outlier, cut W to
+         * the second outage and erased 14 s of real loss as "flowing" (gate sync_storm 430 s: 15 s of pictures without
+         * sound once the audio joined) */
+        vlw = v->pass_wc ? v->pass_wc : v->last_wc;
+        W  = (atomic_load_explicit(&g_bank_us, memory_order_relaxed) > 0 || (int64_t)g_preroll_ms >= 4000) ? 0 :
+             FFMAX(input_wall_gap(t, first_new_wc),
+                   vlw && first_new_wc != INT64_MAX && first_new_wc - vlw >= g_gap_min_us ? first_new_wc - vlw : 0);
+        for (si = 0; si < t->nst; si++)
+            if (t->st[si].res == 1 && d->ts_outl && si < d->nb_streams_open &&
+                d->ts_outl[si].dmg_wc && nw - d->ts_outl[si].dmg_wc < W + 3000000)
+                dmg = 1;
+        if (J > 0) {
+            /* damage hides lost content from the wall evidence (packets keep coming, pictures do not), but no more than
+             * the damage phase lasted: one corrupt PES at a splice proved a 38 s "hole" on a relabel (gate sync_burstjump:
+             * a 13 s video PTS hole) and 9094 s across a wrap (mvwrap jump_return_50). 2.2 T-451: the phase ends at its last
+             * corrupt packet or where the event began — not at the window's close (a big step's window waits up to 3 s for
+             * its partner; counted, 1.06 s of that wait was kept as a hole: sync_excursion mirror) */
+            dspan = dmg && t->dmg_start_wc ? FFMAX(t->open_wc, t->dmg_seen_wc) - t->dmg_start_wc : 0;
+            keep  = FFMIN(J, (FFMAX(W, dspan) + fd / 2) / fd * fd);
+            erase = J - keep;
+        } else {
+            /* a step back while the input flowed: the new content follows on directly. After a wall gap it is a new
+             * domain (an origin restart): the output already filled the gap (bars / silence), so the gap is kept and the
+             * new content follows it — kept 0 put it 20 s behind the hold fill, which dropped the returning audio and
+             * the copied AC-3 until the labels caught up (gate sync_ac3_kill_return_20, mosaic kill_return_20) */
+            keep  = W ? (W + fd / 2) / fd * fd : 0;
+            erase = J - keep;
+        }
+        k_new = k_old - erase;
+        prog_event = 1;
+        cls = J > 0 && keep == J ? "hole kept" : keep && J > 0 ? "hole, flowing part erased" : J > 0 ? "relabel erased" :
+              keep ? "new domain, gap kept" : "step back erased";
+        /* the new content resumes at a keyframe only where content was lost (a hole, damage): a relabel while the input
+         * flowed keeps the bitstream's references — dropping to the next keyframe left ~1 s video PTS holes (sync_bstep) */
+        if (erase && (W > 0 || dmg) && !d->drop_until_kf && g_drop_until_kf) {
+            int i;
+            for (i = 0; i < t->nheld; i++)
+                if (t->held[i].si == vs && t->held[i].path == 1) {
+                    if (!(t->held[i].pkt->flags & AV_PKT_FLAG_KEY)) {
+                        d->drop_until_kf = 1;  /* the new content resumes at a keyframe */
+                        d->kf_arm_us     = nw;
+                        d->kf_arm_vdrop  = d->vdrop;
+                    }
+                    break;
+                }
+        }
+    } else {
+        for (si = 0; si < t->nst; si++) {
+            TlStream *s = &t->st[si];
+            int64_t js, step = s->step_us ? s->step_us : 20000;
+            if (s->res != 1)
+                continue;
+            cls = "single-stream step, labels as sent";
+            if (d->ifmt->streams[si]->codecpar->codec_type != AVMEDIA_TYPE_AUDIO || (d->ts_outl && si < d->nb_streams_open &&
+                d->ts_outl[si].dmg_wc && nw - d->ts_outl[si].dmg_wc < 3000000))
+                continue;
+            /* design invariant 6, the 0.9.16.4 rule: one audio stream stepping BACK on clean audio is a relabel (its sound
+             * runs on) — repaired on that stream, never a map event; the same stream stepping forward again by about the
+             * repair is its return leg and undoes it (T-080 B2: -X/+X nets to zero). Any other forward step is that
+             * stream's own loss: labels as sent, the audio door pads it. Gate std/sync_arelabel: -300 ms without it */
+            js = s->new_first_us - (s->old_end_us + step);
+            /* from 150 ms: a few frames back is the PES interpolation's own jitter (the next PES's label lands under the
+             * interpolated cursor), no relabel — repaired, GYF's audio moved +95 ms (43-75 ms steps, labels as sent: the
+             * overlap is absorbed). The relabel keys step 300 / 600 ms */
+            if (js < -150000)
+                s->rep_new = -js;
+            else if (js > step && s->rep_us > 0)
+                s->rep_new = -FFMIN(js, s->rep_us);
+            if (llabs(s->rep_us + s->rep_new) > 2000000)
+                s->rep_new = 0;               /* bounded: a repair that keeps growing is no relabel (labels as sent) */
+            if (s->rep_new > 0 && g_rlcheck) {
+                /* T-087: the audio thread checks the content across the seam (relabel or repeat) and the sensor reads it
+                 * accordingly, as after the demux absorber's backward erase this replaces */
+                int j;
+                for (j = 0; j < d->n_audio; j++)
+                    if (d->astream[j] == si && d->aglobal[j] >= 0 && d->aglobal[j] < PTV_MAX_AUDIO) {
+                        int g = d->aglobal[j];
+                        atomic_store_explicit(&g_rl_step_us[g], s->rep_new, memory_order_relaxed);
+                        atomic_store_explicit(&g_rl_wc[g], nw, memory_order_relaxed);
+                        atomic_fetch_add_explicit(&g_rl_seq[g], 1, memory_order_relaxed);
+                        s->rl_mark = 1;
+                    }
+            }
+            if (s->rep_new) {
+                s->rep_us += s->rep_new;
+                cls = s->rep_new > 0 ? "single-stream relabel, repaired on the stream" :
+                                       "single-stream return leg, repair undone";
+            }
+        }
+    }
+    t->ev_n++;
+    av_log(NULL, prog_event ? AV_LOG_WARNING : AV_LOG_INFO,
+           "[PTV-TL] event #%"PRId64" (stream %d opened): %s", t->ev_n, t->trig, cls);
+    if (prog_event)
+        av_log(NULL, prog_event ? AV_LOG_WARNING : AV_LOG_INFO,
+               " — J %+.3f s, wall %.3f s%s, kept %.3f s, erased %.3f s (%"PRId64" pictures), k %+.3f s",
+               J / 1e6, W / 1e6, dmg ? " (damaged)" : "", keep / 1e6, erase / 1e6, fd ? erase / fd : 0,
+               k_new / 1e6);
+    for (si = 0; si < t->nst; si++)
+        if (t->st[si].dense && t->st[si].res == 1)
+            av_log(NULL, prog_event ? AV_LOG_WARNING : AV_LOG_INFO, " [s%d %+.3f s]", si,
+                   (t->st[si].new_first_us - t->st[si].old_end_us) / 1e6);
+    av_log(NULL, prog_event ? AV_LOG_WARNING : AV_LOG_INFO, " window %.2f s, %d held\n",
+           (av_gettime_relative() - t->open_wc) / 1e6, t->nheld);
+
+    if (prog_event) {
+        atomic_store_explicit(&t->prog_wc, nw, memory_order_relaxed);
+        if (d->single)
+            atomic_store_explicit(&g_tl_prog_wc, nw, memory_order_relaxed);
+        k_move(d, t, k_new - k_old);
+        if (k_new != k_old) {
+            ptv_vwait_rebase(d, vb, va, t->open_wc, t->open_pos, t->open_vn, av_rescale_q(k_new - k_old, AV_TIME_BASE_Q, (AVRational){ 1, 90000 }));
+            t->ev_va = va;
+            t->ev_dk = k_new - k_old;
+            t->ev_wc = nw;
+        }
+    }
+    ret = release(d, t, k_old, k_new, prog_event, va, vb);
+    /* the paths go on where each stream ended */
+    for (si = 0; si < t->nst; si++) {
+        TlStream *s = &t->st[si];
+        if (!s->dense)
+            continue;
+        if (s->res == 1 && s->rep_new) {
+            d->wrap_off[si] += av_rescale_q(s->rep_new, AV_TIME_BASE_Q, d->ifmt->streams[si]->time_base);
+            ptv_rsync_post_edit(d, si, s->rep_new);
+            s->new_last_us += s->rep_new;
+            s->rep_new = 0;
+        }
+        if (s->res == 1) {
+            if (prog_event) {
+                s->strag_last_us  = s->old_end_us;
+                s->strag_until_wc = nw + TL_STRAG_US;
+            }
+            s->last_us = s->new_last_us;
+            s->last_wc = nw;
+        } else if (prog_event && !has_held(t, si) && (!flowing(t, s) || sil_out)) {
+            s->ok = 0;                        /* not part of it: its next packet re-seeds the path, no window */
+        } else if (s->ok)
+            s->last_us = s->old_end_us;
+        s->res = 0;
+    }
+    if (prog_event) {                         /* a stream joining late must not bring back what the event erased */
+        t->er_lo = erase > 0 ? va : 0;
+        t->er_hi = erase > 0 ? vb : 0;
+        /* 2.2 T-451: the event took the damage phase it saw into account — the next corrupt packet starts a new one. Kept, a
+         * return 2 s after a damaged departure measured its "damage" from the departure: 2.12 s kept as a hole of content
+         * that was all there (sync_excursion; live cor-3 Curiosity 1.88 s) */
+        t->dmg_start_wc = 0;
+    }
+    t->active = 0;
+    return ret;
+}
+
+int ptv_tl_ingest(DemuxArgs *d, AVPacket *pkt)
+{
+    PtvTimeline *t = d->tl;
+    int si = pkt->stream_index;
+    int64_t nw = av_gettime_relative(), s_us;
+    int ret;
+    TlStream *s;
+
+    if (t->last_any_wc && nw - t->last_any_wc >= g_gap_min_us) {
+        /* the input went silent inside a window the video opened: decide it on the evidence before this silence (a lone
+         * picture = an outlier, dropped), then this packet starts afresh with J and W from the same old-path picture.
+         * Waiting through the silence gave each storm event the silence AFTER its jump as W and merged a content scrap
+         * with the next outage — 14 s of real loss erased (sync_storm 430 s). An audio-first crossing (the video not yet
+         * crossed) keeps waiting (win_from) */
+        if (t->active && t->trig == d->vstream) {
+            int r = close_window(d, t);
+            if (r < 0) {
+                av_packet_free(&pkt);
+                return r;
+            }
+        }
+        t->gap_us     = nw - t->last_any_wc;
+        t->gap_end_wc = nw;
+    }
+    t->last_any_wc = nw;
+    if (d->ts_outl)
+        for (int i = 0; i < t->nst && i < d->nb_streams_open; i++)
+            if (d->ts_outl[i].dmg_wc > t->dmg_seen_wc) {
+                if (!t->dmg_seen_wc || !t->dmg_start_wc || d->ts_outl[i].dmg_wc - t->dmg_seen_wc > 3000000)
+                    t->dmg_start_wc = d->ts_outl[i].dmg_wc;
+                t->dmg_seen_wc = d->ts_outl[i].dmg_wc;
+            }
+    s_us = pkt_s_us(d, pkt, t->k_us);
+    if (si >= t->nst)
+        return ptv_demux_dispatch(d, pkt);
+    s = &t->st[si];
+    s->dense = is_dense(d, si);
+
+    if (t->active) {
+        /* a window another stream opened: the video going on on its own old path is not part of any decision until it
+         * crosses itself — dispatch it instead of holding it. Held, it stopped the picture and with it the audio's
+         * silence fill ("while video flows"): heavy loss on an audio track darkened its PID for the gap plus the window
+         * (gate loss_100 on the Cinestar media: 1.6-2.4 s) */
+        if (si == d->vstream && t->trig != si && s->ok && s_us != AV_NOPTS_VALUE && !has_held(t, si) &&
+            llabs(s_us - (s->last_us + s->step_us)) <= tol_us(s)) {
+            if (!s->pass_wc && s->last_wc && nw - s->last_wc >= g_gap_min_us)
+                s->pass_wc = s->last_wc;      /* T-433: a stale picture after a silence is no flow — the wall keeps it */
+            path_take(s, s_us, nw);
+            s->win_passed = 1;
+            if (window_over(d, t, nw) || window_resolved(d, t, 0)) {
+                ret = ptv_demux_dispatch(d, pkt);
+                return ret < 0 ? ret : close_window(d, t);
+            }
+            return ptv_demux_dispatch(d, pkt);
+        }
+        if (t->nheld < TL_HELD_MAX) {
+            TlPkt *h = &t->held[t->nheld++];
+            h->pkt = pkt; h->s_us = s_us; h->k_at = t->k_us; h->wc = nw; h->si = si; h->path = 0;
+        } else {
+            av_packet_free(&pkt);              /* cannot happen in a 1 s window; never block the demux */
+            t->drop_n++;
+        }
+        if (window_over(d, t, nw) || t->nheld >= TL_HELD_MAX || window_resolved(d, t, 0))
+            return close_window(d, t);
+        return 0;
+    }
+    /* a sparse copy of the OLD content arriving after a program event (source time before its last old picture) takes the
+     * old offset back: it was unwrapped with the new one */
+    if (!s->dense && s_us != AV_NOPTS_VALUE && t->ev_dk < 0 && nw - t->ev_wc < 10000000 && s_us < t->ev_va)
+        relabel(d, pkt, 0, -t->ev_dk);        /* forward events only: after a step back / restart the NEW content's source
+                                               * time lies below the old end too (rich sync_kill_return_20: 6 subs + 2
+                                               * clears pushed -40 s and lost) */
+    if (!s->dense || s_us == AV_NOPTS_VALUE)
+        return ptv_demux_dispatch(d, pkt);
+    /* sound of a span the last program event erased, arriving after it (the audio was not flowing at the event: a storm,
+     * sync_storm 430 s — 14 s of erased content played under the next pictures, 16 flashes without their beep) */
+    if (t->er_hi > t->er_lo && si != d->vstream) {
+        if (s_us >= t->er_lo && s_us < t->er_hi) {
+            t->strag_n++;
+            av_packet_free(&pkt);
+            return 0;
+        }
+        if (s_us >= t->er_hi)
+            t->er_lo = t->er_hi = 0;          /* past it (a later restart may reuse these source times) */
+    }
+    if (!s->ok) {
+        path_take(s, s_us, nw);
+        return ptv_demux_dispatch(d, pkt);
+    }
+    /* a straggler of the old path after an event: content of the erased span, never shown */
+    if (s->strag_until_wc && nw < s->strag_until_wc &&
+        llabs(s_us - (s->strag_last_us + s->step_us)) <= tol_us(s) &&
+        llabs(s_us - (s->last_us + s->step_us)) > tol_us(s)) {
+        s->strag_last_us = s_us;
+        t->strag_n++;
+        av_packet_free(&pkt);
+        return 0;
+    }
+    /* below the window threshold, an audio stream stepping forward on its own by about an open repair: the repair's return
+     * leg (T-080 B2). Backward steps open a window (off_path), whose close repairs a single audio stream's relabel and
+     * erases a both-stream step; any other forward step is that stream's loss, labels as sent (the audio door pads) */
+    if (g_aglue_ms > 0 && d->ifmt->streams[si]->codecpar->codec_type == AVMEDIA_TYPE_AUDIO &&
+        !(d->ts_outl && si < d->nb_streams_open && d->ts_outl[si].dmg_wc && nw - d->ts_outl[si].dmg_wc < 3000000)) {
+        int64_t js = s_us - (s->last_us + s->step_us), rp = 0;
+        if (js > (int64_t)g_aglue_ms * 1000 && js <= g_tl_open_us && s->rep_us > 0)
+            rp = -FFMIN(js, s->rep_us);
+        if (rp) {
+            s->rep_us += rp;
+            d->wrap_off[si] += av_rescale_q(rp, AV_TIME_BASE_Q, d->ifmt->streams[si]->time_base);
+            ptv_rsync_post_edit(d, si, rp);
+            relabel(d, pkt, 0, rp);
+            s_us += rp;
+            t->ev_n++;
+            av_log(NULL, AV_LOG_INFO, "[PTV-TL] event #%"PRId64" (stream %d): single-stream %s %+.3f s on the stream "
+                   "(repair now %+.3f s)\n", t->ev_n, si, rp > 0 ? "relabel, repaired" :
+                   "return leg, repair undone", rp / 1e6, s->rep_us / 1e6);
+        }
+    }
+    /* a forward jump the stream's own wall silence explains (J <= W) is a kept hole whatever its partners do: no offset
+     * moves, nothing is relabelled or erased — a window would only hold the input (heavy loss: every lost audio run held
+     * all streams up to 1 s, vt-cap-awe loss_100 audio dark 2.1 s, pre8 0.84 s). Windows stay for what can move the
+     * offset: a jump beyond its silence (relabel / flowing part), a step back; and under an armed bank (W no evidence) */
+    if (off_path(s, s_us) && s_us > s->last_us && s->last_wc &&
+        !(atomic_load_explicit(&g_bank_us, memory_order_relaxed) > 0 || (int64_t)g_preroll_ms >= 4000) &&
+        s_us - (s->last_us + s->step_us) <= nw - s->last_wc + tol_us(s)) {
+        t->ev_n++;
+        av_log(NULL, AV_LOG_INFO, "[PTV-TL] event #%"PRId64" (stream %d): hole kept — J %+.3f s within its own silence of "
+               "%.3f s, labels as sent, no window\n", t->ev_n, si,
+               (s_us - (s->last_us + s->step_us)) / 1e6, (nw - s->last_wc) / 1e6);
+        path_take(s, s_us, nw);
+        return ptv_demux_dispatch(d, pkt);
+    }
+    if (off_path(s, s_us)) {
+        TlPkt *h = &t->held[0];
+        t->active    = 1;
+        t->trig      = si;
+        t->open_wc   = nw;
+        t->open_s_us = s_us;
+        t->open_pos  = pkt->pos;
+        t->open_vn   = d->vunwrap_n;
+        t->nheld     = 1;
+        t->win_big   = 0;
+        h->pkt = pkt; h->s_us = s_us; h->k_at = t->k_us; h->wc = nw; h->si = si; h->path = 0;
+        for (int i = 0; i < t->nst; i++) {     /* a stream the window never classifies keeps its path */
+            t->st[i].old_end_us = t->st[i].last_us;
+            t->st[i].win_passed = 0;
+            t->st[i].pass_wc    = 0;
+        }
+        if (d->disturb_epoch)
+            atomic_fetch_add_explicit(d->disturb_epoch, 1, memory_order_relaxed);
+        return 0;
+    }
+    path_take(s, s_us, nw);
+    return ptv_demux_dispatch(d, pkt);
+}
+
+/* our own cut (the depth door): the span [Va, Vb) was dropped on every stream on the pictures' boundaries — erase it
+ * from the program offset; every path re-seeds on its next packet (the door made them continuous) */
+void ptv_tl_cut(DemuxArgs *d, int64_t cut_us)
+{
+    PtvTimeline *t = d->tl;
+    int si;
+    if (!t || cut_us <= 0)
+        return;
+    k_move(d, t, -cut_us);
+    for (si = 0; si < t->nst; si++)
+        t->st[si].ok = 0;
+}
+
+/* the copy path: dense copies take the video's placement while the map settles — within 30 s of a program event, or
+ * while the source holds — and the old stamping otherwise (house_skew is where the video puts them in steady flow; their
+ * wait for the shown picture read as a gap to the copy watch: AC-3 dark 1.8 s under heavy loss, gate vt-cin loss_100) */
+int ptv_tl_settling(DemuxArgs *d)
+{
+    int64_t pw;
+    if (!d->tl)
+        return 0;
+    pw = atomic_load_explicit(&d->tl->prog_wc, memory_order_relaxed);
+    return ptv_src_holding() || (pw && av_gettime_relative() - pw < 30000000);
+}
