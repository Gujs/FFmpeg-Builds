+        const char *out_url = g->arg;
+        if (!(rung[r].ofmt->oformat->flags & AVFMT_NOFILE))
+            if ((ret = avio_open(&rung[r].ofmt->pb, out_url, AVIO_FLAG_WRITE)) < 0) {
