+        if (g_aglue_ms > 0 && frame->pts != AV_NOPTS_VALUE && !a->hold_feeding) {   /* pre6: fill is stamped at the door */
+            int64_t raw_us = av_rescale_q(frame->pts, a->ist_tb, AV_TIME_BASE_Q);
+            int64_t now_wc = av_gettime_relative();
