+void show_help_default(const char *opt, const char *arg)
+{
+    av_log(NULL, AV_LOG_INFO,
+        "usage: ptvencoder [options] -i <input> [-i <input> ...] [out-opts] <output> [[out-opts] <output> ...]\n"
