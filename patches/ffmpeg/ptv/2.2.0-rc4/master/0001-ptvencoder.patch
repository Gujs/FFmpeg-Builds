+            ptv_rebuild_reanchor(a, a->afmt_qn ? a->afmt_q[0] : frame);   /* pre9.6: the first held frame starts the new path */
+            /* 1.0.1-pre26 ROOT-CAUSE FIX (the NBS/CORELINK backward-label mux killer,
