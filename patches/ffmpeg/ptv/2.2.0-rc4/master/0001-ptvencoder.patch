+static int demux_dispatch(DemuxArgs *d, AVPacket *out)
+{
+    int ret = 0;
+    if ((out->flags & AV_PKT_FLAG_CORRUPT) && g_discardcorrupt) {
+        if (d->ts_outl && out->stream_index < d->nb_streams_open)   /* 2.0.2 T-402: the stream's damage phase (demux_unwrap) */
