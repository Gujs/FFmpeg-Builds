+                        av_log(NULL, AV_LOG_WARNING, "[PTV-AFMT] a%d(in%d) source gap of %"PRId64" ms at the switch — "
+                               "filled with silence (the rebuilt path cannot pad it)\n", a->dbg_k, a->dbg_in, gap / 1000);
