+    is_live = !oc->pb || !(oc->pb->seekable & AVIO_SEEKABLE_NORMAL);
+    if (is_live)
+        oc->max_sparse_interleave_delta = LIVE_SPARSE_INTERLEAVE_DELTA_US;
