diff --git a/fftools/ffmpeg_filter.c b/fftools/ffmpeg_filter.c
index 08a70cd538..1c49cf4890 100644
--- a/fftools/ffmpeg_filter.c
+++ b/fftools/ffmpeg_filter.c
@@ -3303,12 +3303,31 @@ static const char *unknown_if_null(const char *str)
 static int send_frame(FilterGraph *fg, FilterGraphThread *fgt,
                       InputFilter *ifilter, AVFrame *frame)
 {
+    static int64_t audio_frames_to_filter = 0;
+    static int64_t last_audio_filter_log = 0;
     FilterGraphPriv *fgp = fgp_from_fg(fg);
     InputFilterPriv *ifp = ifp_from_ifilter(ifilter);
     FrameData       *fd;
     AVFrameSideData *sd;
     int need_reinit = 0, ret;
 
+    /* Diagnostic: log audio frames entering filter graph */
+    if (ifilter->type == AVMEDIA_TYPE_AUDIO) {
+        audio_frames_to_filter++;
+        int64_t now = av_gettime_relative();
+        if (now - last_audio_filter_log > 5000000) {  /* Every 5 seconds */
+            double pts_sec = frame->pts != AV_NOPTS_VALUE ?
+                             frame->pts * av_q2d(frame->time_base) : -1.0;
+            av_log(fg, AV_LOG_INFO,
+                   "[AUDIO-FILTER-IN] %"PRId64" audio frames to filter, "
+                   "latest pts=%.3fs tb=%d/%d samples=%d\n",
+                   audio_frames_to_filter, pts_sec,
+                   frame->time_base.num, frame->time_base.den,
+                   frame->nb_samples);
+            last_audio_filter_log = now;
+        }
+    }
+
     /* determine if the parameters for this input changed */
     switch (ifilter->type) {
     case AVMEDIA_TYPE_AUDIO:
@@ -3535,6 +3554,14 @@ static int send_frame(FilterGraph *fg, FilterGraphThread *fgt,
     ret = av_buffersrc_add_frame_flags(ifilter->filter, frame,
                                        AV_BUFFERSRC_FLAG_PUSH);
     if (ret < 0) {
+        /* Log when buffersrc rejects an audio frame */
+        if (ifilter->type == AVMEDIA_TYPE_AUDIO) {
+            double pts_sec = frame->pts != AV_NOPTS_VALUE ?
+                             frame->pts * av_q2d(frame->time_base) : -1.0;
+            av_log(fg, AV_LOG_WARNING,
+                   "[AUDIO-FILTER-REJECT] buffersrc rejected audio frame: pts=%.3fs err=%s\n",
+                   pts_sec, av_err2str(ret));
+        }
         av_frame_unref(frame);
         if (ret != AVERROR_EOF)
             av_log(fg, AV_LOG_ERROR, "Error while filtering: %s\n", av_err2str(ret));
