diff --git a/libavfilter/af_aresample.c b/libavfilter/af_aresample.c
index 7c6f9141a7..73795e299b 100644
--- a/libavfilter/af_aresample.c
+++ b/libavfilter/af_aresample.c
@@ -42,7 +42,10 @@ typedef struct AResampleContext {
     double ratio;
     struct SwrContext *swr;
     int64_t next_pts;
+    int64_t last_in_pts;       ///< last input PTS for discontinuity detection
     int more_data;
+    int64_t frame_count;       ///< frames processed (for diagnostics)
+    int64_t last_log_frame;    ///< last frame count when status was logged
 } AResampleContext;
 
 static av_cold int preinit(AVFilterContext *ctx)
@@ -50,6 +53,7 @@ static av_cold int preinit(AVFilterContext *ctx)
     AResampleContext *aresample = ctx->priv;
 
     aresample->next_pts = AV_NOPTS_VALUE;
+    aresample->last_in_pts = AV_NOPTS_VALUE;
     aresample->swr = swr_alloc();
     if (!aresample->swr)
         return AVERROR(ENOMEM);
@@ -220,6 +224,48 @@ static int filter_frame(AVFilterLink *inlink, AVFrame *insamplesref, AVFrame **o
     int ret;
 
     *outsamplesref_ret = NULL;
+
+    /* Detect timestamp discontinuity before processing.
+     * If input PTS jumps by more than 1 second (in either direction),
+     * reset the resampler's timing state to accept a new baseline.
+     * This prevents failed compensation attempts for large discontinuities
+     * such as ad insertion in broadcast streams. */
+    if (insamplesref->pts != AV_NOPTS_VALUE &&
+        aresample->last_in_pts != AV_NOPTS_VALUE) {
+        int64_t delta_pts = insamplesref->pts - aresample->last_in_pts;
+        int64_t expected_delta = av_rescale(n_in, inlink->time_base.den,
+                                            (int64_t)inlink->sample_rate * inlink->time_base.num);
+        int64_t actual_delta = delta_pts > 0 ? delta_pts : -delta_pts;
+        int64_t threshold = inlink->time_base.den / inlink->time_base.num; /* 1 second */
+
+        /* Check if the actual delta differs significantly from expected */
+        if (actual_delta > threshold ||
+            (delta_pts < 0 && actual_delta > expected_delta * 2)) {
+            double delta_sec = delta_pts * av_q2d(inlink->time_base);
+            av_log(ctx, AV_LOG_WARNING,
+                   "aresample: timestamp discontinuity detected (delta=%.3fs), "
+                   "resetting timing state\n", delta_sec);
+            swr_reset_pts(aresample->swr);
+            aresample->next_pts = AV_NOPTS_VALUE;
+        } else if (actual_delta > expected_delta * 10) {
+            /* Log large but sub-threshold gaps for diagnostics */
+            double delta_sec = delta_pts * av_q2d(inlink->time_base);
+            av_log(ctx, AV_LOG_INFO,
+                   "aresample: large timestamp gap (delta=%.3fs, threshold=%.3fs)\n",
+                   delta_sec, threshold * av_q2d(inlink->time_base));
+        }
+    } else if (insamplesref->pts != AV_NOPTS_VALUE &&
+               aresample->last_in_pts == AV_NOPTS_VALUE) {
+        /* First frame with valid PTS - log it for diagnostics */
+        double pts_sec = insamplesref->pts * av_q2d(inlink->time_base);
+        av_log(ctx, AV_LOG_INFO,
+               "aresample: first frame PTS=%.3fs (tb=%d/%d)\n",
+               pts_sec, inlink->time_base.num, inlink->time_base.den);
+    }
+    if (insamplesref->pts != AV_NOPTS_VALUE)
+        aresample->last_in_pts = insamplesref->pts + av_rescale(n_in, inlink->time_base.den,
+                                                                (int64_t)inlink->sample_rate * inlink->time_base.num);
+
     delay = swr_get_delay(aresample->swr, outlink->sample_rate);
     if (delay > 0)
         n_out += FFMIN(delay, FFMAX(4096, n_out));
@@ -249,6 +295,18 @@ static int filter_frame(AVFilterLink *inlink, AVFrame *insamplesref, AVFrame **o
     } else {
         outsamplesref->pts  = AV_NOPTS_VALUE;
     }
+
+    /* Increment frame counter and log status periodically */
+    aresample->frame_count++;
+    if (aresample->frame_count - aresample->last_log_frame >= 1000) {
+        double in_pts_sec = insamplesref->pts * av_q2d(inlink->time_base);
+        double out_pts_sec = outsamplesref->pts * av_q2d(outlink->time_base);
+        av_log(ctx, AV_LOG_INFO,
+               "aresample: processed %"PRId64" frames, in_pts=%.3fs out_pts=%.3fs\n",
+               aresample->frame_count, in_pts_sec, out_pts_sec);
+        aresample->last_log_frame = aresample->frame_count;
+    }
+
     n_out = swr_convert(aresample->swr, outsamplesref->extended_data, n_out,
                                  (void *)insamplesref->extended_data, n_in);
     if (n_out <= 0) {
diff --git a/libswresample/swresample.c b/libswresample/swresample.c
index e7ce4a10aa..3f85d4d213 100644
--- a/libswresample/swresample.c
+++ b/libswresample/swresample.c
@@ -951,3 +951,13 @@ int64_t swr_next_pts(struct SwrContext *s, int64_t pts){
         return s->outpts;
     }
 }
+
+void swr_reset_pts(struct SwrContext *s)
+{
+    if (!s)
+        return;
+
+    s->outpts   = AV_NOPTS_VALUE;
+    s->firstpts = AV_NOPTS_VALUE;
+    s->drop_output = 0;
+}
diff --git a/libswresample/swresample.h b/libswresample/swresample.h
index 052089acca..6af646722b 100644
--- a/libswresample/swresample.h
+++ b/libswresample/swresample.h
@@ -333,6 +333,24 @@ int swr_convert(struct SwrContext *s, uint8_t * const *out, int out_count,
  */
 int64_t swr_next_pts(struct SwrContext *s, int64_t pts);
 
+/**
+ * Reset the PTS/timing state of the resampler.
+ *
+ * Call this when a timestamp discontinuity is detected to make the
+ * resampler accept a new timestamp baseline without attempting to
+ * compensate for the gap. Audio format configuration (sample rates,
+ * channel layouts, etc.) is preserved.
+ *
+ * This is useful for handling stream discontinuities where the input
+ * timestamps jump significantly (e.g., ad insertion in broadcast streams).
+ * Without calling this function, the resampler would try to inject silence
+ * or drop samples to compensate for large timestamp gaps, which can fail
+ * for very large discontinuities.
+ *
+ * @param s  allocated Swr context
+ */
+void swr_reset_pts(struct SwrContext *s);
+
 /**
  * @}
  *
