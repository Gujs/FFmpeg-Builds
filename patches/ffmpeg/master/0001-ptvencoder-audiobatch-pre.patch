+        d->shed_wall = &inputs[kk].shed_wall;           /* pre16: per-input self-shed stamp */
+        d->shed_cnt  = &inputs[kk].shed_cnt;
+        d->v_arrive_wc = &inputs[kk].v_arrive_wc;       /* pre17: per-input arrival watermark (corrector §3) */
