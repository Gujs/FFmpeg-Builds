+    int       own_cont;    /* 1 = at arrival this packet was CONTINUOUS with its stream's own
+                            * last_dts_us (|delta| <= PTV_DISC_THRESHOLD_US) — 1.0.1-pre7: a
+                            * stream that never crossed this cycle keeps such packets on its
