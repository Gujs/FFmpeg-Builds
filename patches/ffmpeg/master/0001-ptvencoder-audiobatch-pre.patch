+                                   * through to the shared LAYERA flush (the pre14 path, which
+                                   * handles it perfectly). */
+                                  d->gap_vsnap &&
+                                  d->vpkt - d->gap_vsnap[pkt->stream_index] >=
+                                      FFMAX((int64_t)3, wall_gap / 80000)))) {
