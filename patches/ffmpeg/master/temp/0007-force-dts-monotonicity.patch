+/**
+ * Apply monotonicity correction to timestamps.
+ * Corrects backward jumps to maintain DTS monotonicity.
+ * Resets accumulated offset on large forward jumps (discontinuities).
+ */
+static void ts_monotonicity_correct(Demuxer *d, InputStream *ist, AVPacket *pkt)
+{
+    DemuxStream *ds = ds_from_ist(ist);
+    int64_t dts_error = 0;
+
+    // Apply accumulated per-stream monotonicity offset
+    if (pkt->pts != AV_NOPTS_VALUE)
+        pkt->pts += ds->ts_monotonicity_offset;
+    if (pkt->dts != AV_NOPTS_VALUE)
+        pkt->dts += ds->ts_monotonicity_offset;
+
+    // Calculate error between expected and actual DTS
+    if (pkt->dts != AV_NOPTS_VALUE && ds->next_dts != AV_NOPTS_VALUE) {
+        int64_t expected_dts = av_rescale_q(ds->next_dts, AV_TIME_BASE_Q, pkt->time_base);
+        dts_error = expected_dts - pkt->dts;
+    }
+
+    // Large forward jump: bring timestamps back to maintain timeline continuity
+    // This prevents A/V desync when source has discontinuities (e.g., PCR wraparound)
+    // Threshold configurable via -dts_monotonicity_threshold (in microseconds)
+    if (dts_error * av_q2d(pkt->time_base) < -(dts_monotonicity_threshold / 1000000.0)) {
+        // dts_error is negative (expected - actual < 0 means actual > expected)
+        // Add dts_error (negative) to timestamps to bring them back to expected timeline
+        if (pkt->dts != AV_NOPTS_VALUE) {
+            pkt->dts += dts_error;
+            ds->ts_monotonicity_offset += dts_error;
+        }
+        if (pkt->pts != AV_NOPTS_VALUE)
+            pkt->pts += dts_error;
+        av_log(ist, AV_LOG_WARNING,
+               "Large forward jump corrected (%.1fs), offset now %"PRId64" (stream %d)\n",
+               -dts_error * av_q2d(pkt->time_base), ds->ts_monotonicity_offset, ist->st->id);
+        return;
+    }
+
+    // Backward jump: timestamp went backward, push it forward
+    if (dts_error > 0) {
+        if (pkt->dts != AV_NOPTS_VALUE) {
+            pkt->dts += dts_error;
+            ds->ts_monotonicity_offset += dts_error;
+        }
+        if (pkt->pts != AV_NOPTS_VALUE) {
+            pkt->pts += dts_error;
+        }
+        av_log(ist, AV_LOG_DEBUG,
+               "DTS backward jump corrected: %"PRId64" units, "
+               "offset now %"PRId64" (stream %d)\n",
+               dts_error, ds->ts_monotonicity_offset, ist->st->id);
+    }
+}
