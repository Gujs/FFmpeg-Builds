From: Claude Assistant <noreply@anthropic.com>
Date: Sun, 19 Jan 2026
Subject: [PATCH] libavformat/mpegts: correct timestamp overflow on PCR wraparound

MPEG-TS uses 33-bit timestamps (PCR/PTS/DTS) that wrap every ~26.5 hours.
This patch detects PCR loopback and adjusts timestamps to maintain
continuity across the wraparound.

Ported from FFmpeg 5.1 patch by Alen Vrecko <alen.vrecko@fora.si>
---
diff --git a/libavformat/mpegts.c b/libavformat/mpegts.c
index 7c19abaf76..abcdef1234 100644
--- a/libavformat/mpegts.c
+++ b/libavformat/mpegts.c
@@ -101,6 +101,7 @@ struct MpegTSFilter {
     int es_id;
     int last_cc; /* last cc code (-1 if first packet) */
     int64_t last_pcr;
+    int pcr_loopback_count;
     int discard;
     enum MpegTSFilterType type;
     union {
@@ -277,6 +278,33 @@ typedef struct PESContext {
 
 EXTERN const FFInputFormat ff_mpegts_demuxer;
 
+/**
+ * Adjust timestamp to preserve continuity across PCR wraparound.
+ * MPEG-TS uses 33-bit timestamps that wrap every ~26.5 hours.
+ */
+static int64_t preserve_continuity(const MpegTSFilter *filter, int64_t timestamp)
+{
+    if (timestamp < 0 || filter->last_pcr < 0) {
+        return timestamp;
+    }
+
+    /* if pcr is in the first third of its range of value
+       and timestamp in the last third of its range then correct loopback value */
+    if (filter->last_pcr < (SYSTEM_CLOCK_FREQUENCY_DIVISOR * (1LL << 33)) / 3 &&
+        timestamp > (2LL * (1LL << 33)) / 3) {
+        return timestamp + (filter->pcr_loopback_count - 1) * (1LL << 33);
+    }
+    /* if pcr is in the last third of its range of value
+       and timestamp in the first third of its range then correct loopback value */
+    else if (filter->last_pcr > (2LL * SYSTEM_CLOCK_FREQUENCY_DIVISOR * (1LL << 33)) / 3 &&
+             timestamp < (1LL << 33) / 3) {
+        return timestamp + (filter->pcr_loopback_count + 1) * (1LL << 33);
+    }
+    else {
+        return timestamp + filter->pcr_loopback_count * (1LL << 33);
+    }
+}
+
 static struct Program * get_program(MpegTSContext *ts, unsigned int programid)
 {
     int i;
@@ -1016,6 +1044,7 @@ static void new_data_packet(const uint8_t *buffer, int len, AVPacket *pkt)
 static int new_pes_packet(PESContext *pes, AVPacket *pkt)
 {
     uint8_t *sd;
+    MpegTSFilter *filter;
 
     av_packet_unref(pkt);
 
@@ -1053,8 +1082,16 @@ static int new_pes_packet(PESContext *pes, AVPacket *pkt)
         pkt->stream_index = pes->sub_st->index;
     else
         pkt->stream_index = pes->st->index;
-    pkt->pts = pes->pts;
-    pkt->dts = pes->dts;
+    /* if PCR PID available then use PCR loopback count to preserve DTS and PTS continuity */
+    if (pes->stream->correct_ts_overflow && pes->pcr_pid > 0) {
+        filter = pes->ts->pids[pes->pcr_pid];
+        pkt->dts = preserve_continuity(filter, pes->dts);
+        pkt->pts = preserve_continuity(filter, pes->pts);
+    } else {
+        pkt->dts = pes->dts;
+        pkt->pts = pes->pts;
+    }
+
     /* store position of first TS packet of this PES packet */
     pkt->pos   = pes->ts_packet_pos;
     pkt->flags = pes->flags;
@@ -2959,8 +2996,15 @@ static int handle_packet(MpegTSContext *ts, const uint8_t *packet, int64_t pos)
     if (has_adaptation) {
         int64_t pcr_h;
         int pcr_l;
-        if (parse_pcr(&pcr_h, &pcr_l, packet) == 0)
+        if (parse_pcr(&pcr_h, &pcr_l, packet) == 0) {
+            /* detect PCR loopback (33-bit wraparound every ~26.5 hours) */
+            if ((tss->last_pcr - pcr_h * SYSTEM_CLOCK_FREQUENCY_DIVISOR) >
+                ((SYSTEM_CLOCK_FREQUENCY_DIVISOR * (1LL << 33)) - 27000000)) {
+                ++tss->pcr_loopback_count;
+                av_log(ts->stream, AV_LOG_DEBUG, "PCR loopback detected\n");
+            }
             tss->last_pcr = pcr_h * SYSTEM_CLOCK_FREQUENCY_DIVISOR + pcr_l;
+        }
         /* skip adaptation field */
         p += p[0] + 1;
     }
@@ -3137,6 +3181,7 @@ static int handle_packets(MpegTSContext *ts, int64_t nb_packets)
                 }
                 ts->pids[i]->last_cc = -1;
                 ts->pids[i]->last_pcr = -1;
+                ts->pids[i]->pcr_loopback_count = 0;
             }
         }
     }
