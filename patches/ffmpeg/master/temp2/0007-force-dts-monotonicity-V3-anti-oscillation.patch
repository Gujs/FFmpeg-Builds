+/**
+ * Find the timing reference stream for monotonicity correction.
+ * Uses PCR stream from MPEG-TS programs if available, otherwise first video stream.
+ * Returns stream index, or -2 if no suitable reference found.
+ */
+static int find_ts_reference_stream(Demuxer *d)
+{
+    AVFormatContext *ctx = d->f.ctx;
+    int first_video = -1;
+
+    // Check MPEG-TS programs for PCR PID
+    for (unsigned i = 0; i < ctx->nb_programs; i++) {
+        AVProgram *prog = ctx->programs[i];
+        if (prog->pcr_pid > 0) {
+            // Find stream with matching PID (stored in stream->id for MPEG-TS)
+            for (unsigned j = 0; j < ctx->nb_streams; j++) {
+                if (ctx->streams[j]->id == prog->pcr_pid) {
+                    av_log(d, AV_LOG_INFO,
+                           "Using PCR stream %d (PID 0x%x) as timing reference for monotonicity correction\n",
+                           j, prog->pcr_pid);
+                    return j;
+                }
+            }
+        }
+    }
+
+    // Fallback: use first video stream
+    for (unsigned i = 0; i < ctx->nb_streams; i++) {
+        if (ctx->streams[i]->codecpar->codec_type == AVMEDIA_TYPE_VIDEO) {
+            first_video = i;
+            break;
+        }
+    }
+
+    if (first_video >= 0) {
+        av_log(d, AV_LOG_INFO,
+               "No PCR stream found, using video stream %d as timing reference for monotonicity correction\n",
+               first_video);
+        return first_video;
+    }
+
+    av_log(d, AV_LOG_WARNING,
+           "No suitable timing reference stream found for monotonicity correction\n");
+    return -2;
+}
+
+/**
+ * Apply monotonicity correction to timestamps.
+ * Uses a shared reference offset determined by the PCR/video stream.
+ * This ensures all streams receive the same correction, maintaining A/V sync.
+ */
+static void ts_monotonicity_correct(Demuxer *d, InputStream *ist, AVPacket *pkt)
+{
+    DemuxStream *ds = ds_from_ist(ist);
+    int is_ref_stream;
+    int64_t offset_in_tb;
+
+    // Find reference stream on first call
+    if (d->ts_ref_stream_index == -1)
+        d->ts_ref_stream_index = find_ts_reference_stream(d);
+
+    is_ref_stream = (ist->st->index == d->ts_ref_stream_index);
+
+    // Convert shared offset from AV_TIME_BASE to packet's time_base
+    offset_in_tb = av_rescale_q(d->ts_monotonicity_ref_offset, AV_TIME_BASE_Q, pkt->time_base);
+
+    // Apply the shared offset to this packet
+    if (pkt->pts != AV_NOPTS_VALUE)
+        pkt->pts += offset_in_tb;
+    if (pkt->dts != AV_NOPTS_VALUE)
+        pkt->dts += offset_in_tb;
+
+    // Only the reference stream detects discontinuities and updates the shared offset
+    if (is_ref_stream && pkt->dts != AV_NOPTS_VALUE && ds->next_dts != AV_NOPTS_VALUE) {
+        int64_t expected_dts = av_rescale_q(ds->next_dts, AV_TIME_BASE_Q, pkt->time_base);
+        int64_t dts_error = expected_dts - pkt->dts;
+        double error_sec = dts_error * av_q2d(pkt->time_base);
+
+        // Large forward jump: bring timestamps back to maintain timeline continuity
+        if (error_sec < -(dts_monotonicity_threshold / 1000000.0)) {
+            // Convert correction to AV_TIME_BASE and update shared offset
+            int64_t correction_avbase = av_rescale_q(dts_error, pkt->time_base, AV_TIME_BASE_Q);
+            d->ts_monotonicity_ref_offset += correction_avbase;
+
+            // Apply to this packet
+            if (pkt->dts != AV_NOPTS_VALUE)
+                pkt->dts += dts_error;
+            if (pkt->pts != AV_NOPTS_VALUE)
+                pkt->pts += dts_error;
+
+            av_log(ist, AV_LOG_WARNING,
+                   "Large forward jump corrected (%.1fs), shared offset now %"PRId64" us (ref stream %d)\n",
+                   -error_sec, d->ts_monotonicity_ref_offset, ist->st->id);
+            return;
+        }
+
+        // Large backward jump: only correct if exceeds threshold but not too large
+        // A backward jump larger than the forward threshold indicates a source timeline
+        // reset (e.g., timestamps wrapped to 0), not a temporary discontinuity.
+        // In that case, don't swing the offset wildly - let the filter-level
+        // discontinuity handling (patch 0009) deal with stale buffered frames.
+        if (error_sec > (dts_backward_threshold / 1000000.0) &&
+            error_sec < (dts_monotonicity_threshold / 1000000.0)) {
+            int64_t correction_avbase = av_rescale_q(dts_error, pkt->time_base, AV_TIME_BASE_Q);
+            d->ts_monotonicity_ref_offset += correction_avbase;
+
+            if (pkt->dts != AV_NOPTS_VALUE)
+                pkt->dts += dts_error;
+            if (pkt->pts != AV_NOPTS_VALUE)
+                pkt->pts += dts_error;
+
+            av_log(ist, AV_LOG_WARNING,
+                   "Large backward jump corrected (%.3fs), shared offset now %"PRId64" us (ref stream %d)\n",
+                   error_sec, d->ts_monotonicity_ref_offset, ist->st->id);
+        } else if (error_sec >= (dts_monotonicity_threshold / 1000000.0)) {
+            // Source timeline reset detected - don't correct, just log
+            av_log(ist, AV_LOG_WARNING,
+                   "Source timeline reset detected (backward %.1fs > threshold %.1fs), "
+                   "not correcting offset to avoid A/V desync (ref stream %d)\n",
+                   error_sec, dts_monotonicity_threshold / 1000000.0, ist->st->id);
+        }
+    }
+}
