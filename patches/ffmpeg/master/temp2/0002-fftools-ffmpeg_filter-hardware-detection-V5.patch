+    // Skip colorspace/range format filter for hardware pipelines to avoid CPU scale insertion
+    // Hardware filters handle colorspace conversion themselves
+    if (fgp->uses_hwaccel) {
+        av_log(fgp, AV_LOG_DEBUG, "Skipping colorspace format filter for hardware-accelerated pipeline\n");
+    } else {
