     choose_alpha_modes(ofp, &bprint);
     if (!av_bprint_is_complete(&bprint))
         return AVERROR(ENOMEM);
@@ -2058,6 +2075,47 @@ static int graph_is_meta(AVFilterGraph *graph)
 
 static int sub2video_frame(InputFilter *ifilter, AVFrame *frame, int buffer);
 
+/**
+ * Check if any input filter uses hardware acceleration.
+ * @return 1 if hardware-accelerated, 0 otherwise
+ */
+static int filtergraph_uses_hwaccel(FilterGraph *fg)
+{
+    for (int i = 0; i < fg->nb_inputs; i++) {
+        InputFilterPriv *ifp = ifp_from_ifilter(fg->inputs[i]);
+        if (ifp->hw_frames_ctx)
+            return 1;
+    }
+    return 0;
+}
+
+/**
+ * Check if the configured filter graph contains hardware filters.
+ * This handles cases where input is CPU but hwupload+scale_cuda are in the graph.
+ * @return 1 if hardware filters detected, 0 otherwise
+ */
+static int filtergraph_has_hw_filters(AVFilterGraph *graph)
+{
+    if (!graph)
+        return 0;
+
+    // Check for common hardware filter names
+    for (unsigned i = 0; i < graph->nb_filters; i++) {
+        const char *filter_name = graph->filters[i]->filter->name;
+
+        // Check for hardware scaling filters
+        if (strstr(filter_name, "_cuda") ||      // scale_cuda, hwupload_cuda, etc.
+            strstr(filter_name, "_vaapi") ||     // scale_vaapi, etc.
+            strstr(filter_name, "_qsv") ||       // scale_qsv, etc.
+            strstr(filter_name, "_videotoolbox") || // scale_videotoolbox, etc.
+            strstr(filter_name, "_vulkan") ||    // scale_vulkan, etc.
+            strstr(filter_name, "_opencl") ||    // scale_opencl, etc.
+            strstr(filter_name, "_amf"))         // scale_amf, etc.
+            return 1;
+    }
+    return 0;
+}
+
 static int configure_filtergraph(FilterGraph *fg, FilterGraphThread *fgt)
 {
     FilterGraphPriv *fgp = fgp_from_fg(fg);
@@ -2067,6 +2125,11 @@ static int configure_filtergraph(FilterGraph *fg, FilterGraphThread *fgt)
     int have_input_eof = 0;
     const char *graph_desc = fg->graph_desc;
 
+    // Detect hardware acceleration before cleaning up the graph
+    // This preserves the hardware acceleration state across reconfigurations
+    if (!fgp->uses_hwaccel)
+        fgp->uses_hwaccel = filtergraph_uses_hwaccel(fg);
+
     cleanup_filtergraph(fg, fgt);
     fgt->graph = avfilter_graph_alloc();
     if (!fgt->graph)
@@ -2117,6 +2180,12 @@ static int configure_filtergraph(FilterGraph *fg, FilterGraphThread *fgt)
     if (ret < 0)
         goto fail;
 
+    // Check for hardware filters in the parsed graph BEFORE configuring outputs
+    // This must happen after graph_parse() but before configure_output_filter()
+    // to prevent CPU scale filter insertion in hardware pipelines
+    if (!fgp->uses_hwaccel && filtergraph_has_hw_filters(fgt->graph))
+        fgp->uses_hwaccel = 1;
+
     for (cur = inputs, i = 0; cur; cur = cur->next, i++)
         if ((ret = configure_input_filter(fg, fgt->graph, fg->inputs[i], cur)) < 0) {
             avfilter_inout_free(&inputs);

