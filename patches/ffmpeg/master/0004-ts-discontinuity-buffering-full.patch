+    int64_t                  ts_offset_discont;      /* Per-stream timestamp offset */
+    int                      discontinuity_pending;  /* Flag when discontinuity just detected */
+    int64_t                  last_raw_dts;           /* Last DTS before any adjustment (AV_TIME_BASE) */
